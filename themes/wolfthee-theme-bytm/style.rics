/* ==============
    :3 mode
=================== */

@if $uwu-mode == true {
  @keyframes playing-animation { /* Moves the white part */
	  0% {
      rotate: 0deg

	  }
	  100% {
	  	rotate: 359deg
	  }
  }

  .blyrics-container:has(.blyrics--active) > div:not(.blyrics--active):not(.blyrics--active ~ div)::before {
    color: var(--blyrics-lyric-active-color);
  }

  .blyrics--instrumental-icon {
    display: none;
  }

  .blyrics--instrumental.blyrics--line::before {
    padding-left: 0.3em;
    padding-right: 0.3em;
    font-size: calc(var(--blyrics-font-size) - 1.5rem );
    content: ":3" !important;
    color: var(--blyrics-lyric-inactive-color);
  }

  .blyrics--instrumental.blyrics--line::after {
    padding-left: 0 !important;
    font-size: 0px !important;
    content: "" !important;
    position: absolute;
    color: var(--blyrics-lyric-active-color);
    overflow: hidden;
    width: 0px;
    text-wrap: nowrap;
    mask-image: linear-gradient(90deg, black calc( 100% - 0.2em), transparent 100%);
  }

  .blyrics--instrumental.blyrics--line.blyrics--pre-animating.blyrics--active.blyrics--animating::before {
    animation: playing-animation calc(var(--blyrics-duration)* 0.9) linear forwards var(--blyrics-anim-delay);
    animation-fill-mode: forwards; 
    //filter: drop-shadow(0px 0px 4px rgba(255,255,255,0.75));
    color: $highlight-background-color;
  }

  .blyrics--instrumental.blyrics--line.blyrics--paused::before {
    animation-play-state: paused !important;
  }



  .ytmusic-logo {
    content: url("https://raw.githubusercontent.com/WolftheE/better-ytm/refs/heads/main/images/uwu-tube.png");
    height: 24px;
  }

  #placeholder {
    content: ">w<"
  }
}
