// Varables

/*
 * blyrics-letter-wave = true;
 */

$darkest-bg: #000000;
$normal-bg: #030303;
$bright-bg: #101010;
$transparent-bg: rgba(5, 5, 5, 0.7);
$heavy-transparent-bg: rgba(5, 5, 5, 0.2);

$strong-text: #ffffff;
$muted-text: #bcbcbc;
$unimportant-text: #646464;
$shadow: 0 3px 7px 0 rgba(0, 0, 0, 0.1);

$button-bg: rgba(255,255,255,0.05);
$borders: rgba(255,255,255,0.1);
$hover-bg: rgba(255,255,255,0.1);
$clicked-bg: rgba(255,255,255,0.3);
$hover-text: white;

$highlight-color: white;
$highlight-text: black;
$primary-color: white;

$border-radius: 6px;
$background-blur: 8px;
$transition-time: 0.25s;

$background-album-brightness: 70%; // These only works without blyric shaders
$background-album-saturation: 125%;
$background-album-blur: 82px;

// Toggles
$three-dots-instrument: true;
$new-lyric-style: true;
$custom-icons: true;
$album-glow: false;

$new-media-bar: true; // make this false to go back to YT's one
$floating-media-bar: true;
$fully-transparent-media-bar: false;


:root {
  --ease-in: cubic-bezier(.4, 0, 1, 1);
  --ease-out: cubic-bezier(0, 0, .2, 1);
  --ease-in-out: cubic-bezier(.4, 0, .2, 1);
  --ease-out-back: cubic-bezier(.34, 1.56, .64, 1);
  --ease-elastic: cubic-bezier(.68, -.55, .265, 1.55);
  --ease-spring: cubic-bezier(.175, .885, .32, 1.275);


  --blyrics-footer-bg-color: transparent;
  --blyrics-footer-border-color: transparent;

  --blyrics-scale-transition-duration: 0.3s;

  --blyrics-active-scale: 1;
  --blyrics-scale: 0.58;
  --blyrics-line-height: 1.33;
  --blyrics-font-size: 4.25rem;
  --blyrics-font-weight: 650;
  --smaller-lyrics-size: 0.6em;
  --blyrics-fullscreen-panel-size: 55%;

  --blyric-music-note-icon: path("M10 6A1 1 0 0010 20 1 1 0 0010 6M32 6A1 1 0 0032 20 1 1 0 0032 6M54 6A1 1 0 0054 20 1 1 0 0054 6");
  --blyrics-instrumental-wave-path-high: path("M -4 3 Q 1 2 5 3 Q 10 4 14 3 Q 18 2 22 3 Q 26 4 30 3 Q 35 2 40 3 Q 45 4 50 3 Q 55 2 60 3 Q 64 4 68 3 L 68 4 L -4 4 Z");
  --blyrics-instrumental-wave-path-low: path("M -4 3 Q 1 4 5 3 Q 10 2 14 3 Q 18 4 22 3 Q 26 2 30 3 Q 35 4 40 3 Q 45 2 50 3 Q 55 4 60 3 Q 64 2 68 3 L 68 4 L -4 4 Z");

  --blyrics-wobble-duration: 1.75s;
  --blyrics-word-wobble-transform-from: translateY(0px) scaleX(1);
  --blyrics-word-wobble-transform-peak: scaleX(1.025);
  --blyrics-word-wobble-transform-settle: translateY(-0.1em) scaleX(1.005);
  --blyrics-word-wobble-transform-to: translateY(-0.085em) scaleX(1);

  --blyrics-letter-wave-duration: 1.5s;
  --blyrics-letter-wave-emphasis-scale: 1.05;
}

/* ======================
 *  Buttons, Text, etc
 * = *=====================  */
//sidebar and navgiation buttons
tp-yt-paper-item, ytmusic-search-suggestion, ytmusic-menu-navigation-item-renderer, ytmusic-menu-service-item-renderer, ytmusic-toggle-menu-service-item-renderer {
  transition: transform $transition-time var(--ease-out), background-color $transition-time;
  border-radius: $border-radius !important;

  &:hover {
    background-color: $hover-bg !important;
    transform: translate(4px) !important;
  }

  &:active {background-color: $clicked-bg !important;}
}

ytmusic-player-queue-item, #items.ytmusic-carousel>ytmusic-responsive-list-item-renderer.ytmusic-carousel {
  margin: 2px 6px;
  border-radius: $border-radius;


  transition: scale $transition-time var(--ease-spring), background-color $transition-time var(--ease-out);

  &:hover {
    background-color: $hover-bg !important;
    scale: 1.02;
  }
}
#items.ytmusic-carousel>ytmusic-responsive-list-item-renderer.ytmusic-carousel {height: 64px;}
#items.ytmusic-carousel:has(ytmusic-responsive-list-item-renderer.ytmusic-carousel) {gap: 0;} // fix gap

#items.ytmusic-menu-popup-renderer > .ytmusic-menu-popup-renderer:hover, ytd-compact-link-renderer:hover {background-color: transparent;} // Small fix for duplicated hover effect


// Selected button
ytmusic-guide-entry-renderer[active] tp-yt-paper-item.ytmusic-guide-entry-renderer {
  background-color: $highlight-color;
  color: $highlight-text !important;
  &:hover {background-color: $highlight-color !important;}
  & * {color: $highlight-text !important;}
}


// Normal buttons
.ytSpecButtonShapeNextMono.ytSpecButtonShapeNextOutline, yt-icon-button.ytmusic-carousel-shelf-renderer, ytmusic-chip-cloud-chip-renderer[chip-style=STYLE_LARGE_TRANSLUCENT_AND_SELECTED_WHITE] a.ytmusic-chip-cloud-chip-renderer, .ytSpecButtonShapeNextMono.ytSpecButtonShapeNextTonal {

  background-color: $button-bg;
  box-shadow: $shadow;
  border-radius: $border-radius;

  border: none;

  transition: background-color $transition-time var(--ease-in-out);

  &:hover {background-color: $hover-bg !important;}
  &:active {background-color: $clicked-bg}
}

.ytSpecButtonShapeNextMono.ytSpecButtonShapeNextOutline {outline: 1px solid $borders}

// transition for buttons
.ytSpecButtonShapeNextMono.ytSpecButtonShapeNextText, yt-icon-button {
  transition: background-color $transition-time var(--ease-in-out);
}


// Searchbar
ytmusic-search-box .search-box.ytmusic-search-box, ytmusic-search-box:not([opened]):not([has-query]) .search-box.ytmusic-search-box {
  background-color: $hover-bg;
  border: none;
  box-shadow: $shadow;

  border-radius: $border-radius;
}


/* Search Dropdown animation - Credit goes to Drago and his Lucid theme */
ytmusic-search-box #suggestion-list {
  z-index: 4;
  border-radius: 0 0 $border-radius $border-radius !important;
  box-shadow: none;
  padding: 0 !important;
  margin-top: 0 !important;
  opacity: 0 !important;
  visibility: hidden !important;
  transform: scaleY(0.25) !important;
  transform-origin: top !important;
  pointer-events: none !important;
  display: block !important;
  overflow: hidden;

  border-top: none !important;

  transition: opacity 0.2s cubic-bezier(0.2, 0.8, 0.2, 1), transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), visibility 0.2s !important;
}

ytmusic-search-box[opened]:has(ytmusic-search-suggestion) #suggestion-list, ytmusic-search-box[opened]:has(ytmusic-responsive-list-item-renderer) #suggestion-list {
  opacity: 1 !important;
  visibility: visible !important;
  transform: scaleY(1) !important;
  pointer-events: auto !important;
}

ytmusic-search-box[opened] {
  border: none;
}

// The play button
ytmusic-play-button-renderer {
  transition: opacity $transition-time ease;
}


// Popup menus
tp-yt-iron-dropdown {
  z-index: 4;
  display: block !important;
  visibility: visible;
  transition: visibility 0.5s !important;
}
tp-yt-iron-dropdown[aria-hidden="true"] {visibility: hidden;}

tp-yt-iron-dropdown > div {
  background: $bright-bg !important;
  color: white;
  border: 1px solid $borders;
  border-radius: $border-radius;
  box-shadow: 3px 3px 15px rgba(0,0,0,0.5);

  transition: opacity 0.2s var(--ease-out), transform 0.3s var(--ease-out) !important;
  opacity: 0;
  transform: scale(0.85) !important;
}

tp-yt-iron-dropdown:not(tp-yt-iron-dropdown[aria-hidden="true"]) > div{
  opacity: 1 !important;
  transform: scale(1) !important;
}

#container.ytmusic-multi-select-menu-renderer, #items.ytmusic-multi-select-menu-renderer, tp-yt-paper-listbox {
min-width: 305px;
border: none !important;
border-radius: none !important;
margin:0;
background-color: transparent !important;
}

/* ======================
 *    Main Content
 * = *=====================  */
body {
  background: $normal-bg;
}

ytmusic-browse-response[has-background]:not([disable-gradient]) .background-gradient.ytmusic-browse-response { // bg
  background-image: linear-gradient(to bottom, rgba(0, 0, 0, 0), $normal-bg);
  background-repeat: no-repeat;
}

/* ===== Hover on album effect =====*/
ytmusic-two-row-item-renderer ytmusic-thumbnail-renderer #image { overflow: hidden !important; }
ytmusic-two-row-item-renderer ytmusic-thumbnail-renderer #image img { transition: transform 0.8s cubic-bezier(0.2, 0.8, 0.2, 1), filter 0.4s; }
ytmusic-two-row-item-renderer:hover ytmusic-thumbnail-renderer #image img {
  transform: scale(1.04) !important;
  filter: brightness(0.5);
}

.thumbnail-overlay.ytmusic-two-row-item-renderer {
  overflow: hidden;
  border-radius: $border-radius;
}

ytmusic-item-thumbnail-overlay-renderer[display-style=MUSIC_ITEM_THUMBNAIL_OVERLAY_DISPLAY_STYLE_HOVER] #play-button.ytmusic-item-thumbnail-overlay-renderer, #background.ytmusic-item-thumbnail-overlay-renderer, ytmusic-item-thumbnail-overlay-renderer>:not(.ytmusic-item-thumbnail-overlay-renderer) {
  transition: opacity 0.4s ease-out; /* Overlay transition */
  border-radius: inherit;
}

.content-wrapper.ytmusic-play-button-renderer {
  transition: transform .2s cubic-bezier(.2, 0, .6, 1), box-shadow .2s cubic-bezier(.2, 0, .6, 1);
  background-color: $primary-color;
  color: $highlight-text !important;
  box-shadow: 2px 2px 5px rgba(0,0,0,0.7);
  &:hover {
    background-color: $primary-color !important;
    box-shadow: 2px 2px 10px rgba(0,0,0,0.9);
  }
  & > .icon.ytmusic-play-button-renderer {color:$highlight-text;}
}

ytmusic-play-button-renderer[size=MUSIC_PLAY_BUTTON_SIZE_HUGE] > .content-wrapper.ytmusic-play-button-renderer {
  transition: scale .2s cubic-bezier(.2, 0, .6, 1);
  background-color: rgba(0,0,0,0.0);
  color: $primary-color !important;
  box-shadow: none;
  &:hover {
    scale: 1.2;
    box-shadow: none !important;
    background-color: transparent !important;
  }
  & > .icon.ytmusic-play-button-renderer {color: $primary-color;}
}


// First, make the search bar fixed into the page rather then overlayed
#nav-bar-background.ytmusic-app-layout, ytmusic-app-layout > [slot="nav-bar"] {
position: absolute;
}
ytmusic-nav-bar .center-content.ytmusic-nav-bar {padding-left: calc(100px + var(--ytmusic-guide-width));}
@media (max-width: 1149px) {
  ytmusic-nav-bar:not([guide-collapsed]) .center-content.ytmusic-nav-bar {
    padding-left: calc(56px + var(--ytmusic-guide-width));
  }
}
#nav-bar-background, #nav-bar-divider, #mini-guide-background {display: none;} // hide the navbar background

ytmusic-nav-bar .left-content.ytmusic-nav-bar { // Make the left content of the navbar overlay inside of the sidebar
  top: 16px;
  position: fixed;
  padding-left: 16px;
  display: flex;
  align-items: center;
  width: calc(var(--ytmusic-guide-width) - 8px);
  overflow: hidden;
  flex-shrink: 0;
  height: unset;
  box-sizing: border-box;
}

// Ensure the searchbar is hidden while player is open
#layout[player-ui-state="PLAYER_PAGE_OPEN"] > [slot="nav-bar"] > .center-content , #layout[player-ui-state="PLAYER_PAGE_OPEN"] > [slot="nav-bar"] > .right-content {
display: none !important;
}

// Padding for some content
tp-yt-paper-listbox.ytmusic-menu-popup-renderer, .ytmusicMultiPageMenuRendererMenuContainer, #suggestions {padding: 6px !important;}

// make stuff rounded
.image.ytmusic-player-bar, .thumbnail-image-wrapper.ytmusic-player-bar {
  border-radius: $border-radius;
}

/* ======================
 *        Sidebar
 * = *=====================  */
ytmusic-guide-renderer { // make the thing cover the whole sidebar
  padding-bottom: 0;
  overflow: scroll;
}
#layout[player-ui-state="PLAYER_PAGE_OPEN"] > tp-yt-app-drawer > #contentContainer > div > div > ytmusic-guide-renderer {
height: calc(100vh - var(--ytmusic-nav-bar-height) - 100px);
}

#items.ytmusic-guide-section-renderer {
overflow: visible;
max-height: unset;
}

ytmusic-app #mini-guide.ytmusic-app, ytmusic-app #guide-wrapper.ytmusic-app {
  background-color: transparent;
  border-right: none;
}

#scrim.tp-yt-app-drawer {
background-color: $darkest-bg !important;
border-right: 1px solid $borders;
opacity: 1 !important;
visibility: visible;

transition: opacity $transition-time var(--ease-out) !important;
}

ytmusic-app-layout>[slot=guide] {
  transition: width $transition-time var(--ease-out) !important;
}

#layout[player-ui-state="PLAYER_PAGE_OPEN"] > tp-yt-app-drawer > #scrim.tp-yt-app-drawer {
opacity: 0 !important;
}




/* ======================
 *      Media Bar
 * = *=====================  */
@if $new-media-bar == true {

  #player-bar-background {
  display: none;
  }

  ytmusic-app-layout > [slot="player-bar"]{
    position: fixed;

    @if $floating-media-bar == true {
      bottom: 8px;
      left: calc(16px + var(--ytmusic-guide-width));
      right: 16px;

      outline: 1px solid $borders;
      border-radius: $border-radius;
    }

    @if $floating-media-bar == false {
      bottom: 0;
      left: var(--ytmusic-guide-width);
      right: 0;

      border-top: 1px solid $borders;
    }

    height: 90px;
    width: unset;

    background-color: $transparent-bg;
    backdrop-filter: blur(16px);
    transition: left 0.3s ease;


    grid-template-columns: 1fr 0.5fr 1fr !important;
    grid-template-areas: "start middle end" "start middlebutton end" !important;
    grid-direction: reverse;
    display: grid;
  }

  #layout[player-ui-state="PLAYER_PAGE_OPEN"] >[slot=player-bar] { // hide the padding for the sidebar in player page
  @if $floating-media-bar == true {left: calc(16px);}
  @if $floating-media-bar == false {left: 0;}

  @if $fully-transparent-media-bar == true {background-color: transparent !important;}
  @if $fully-transparent-media-bar == false {background-color: $heavy-transparent-bg !important;}

  outline: none;
  border-top: none;
  backdrop-filter: none;
  }

  ytmusic-app-layout[player-fullscreened]>[slot=player-bar] { // fullscreen fix
    bottom: 0;
    left: 0;
    right: 0;

    border-radius: 0;
  }
  // buttons
  ytmusic-player-bar[is-web-delhi-icons-enabled] yt-icon-button.ytmusic-player-bar {
    transition: background-color $transition-time var(--ease-out);

    border-radius: 100px;
  }


  .left-controls.ytmusic-player-bar { /* Make the player controls center */
    grid-area: middlebutton !important;
    justify-content: center !important;
  }
  // change the buttons of the player controls
  ytmusic-app-layout:not([player-fullscreened]) >[slot=player-bar] > .left-controls.ytmusic-player-bar > div>  #play-pause-button {
    height: 40px;
    width: 40px;

    background-color: white;
    color: black;
    border-radius: 100px;

    transition: scale $transition-time var(--ease-out);

    &:hover {scale: 1.1;}
  }
  #play-pause-button > #button > .style-scope.ytmusic-player-bar {
  height: 24px;
  width: 24px;
  }


  #progress-bar.ytmusic-player-bar { // Center the progress bar
  grid-area: middle !important;
  justify-content: center !important;
  position: static;

  transform: none;
  }

  #progressContainer {
  border-radius: 100px !important;
  overflow: hidden !important;
  }

  #progress-bar.ytmusic-player-bar{  /* Edit the default vaules of the progression bar */
  --paper-slider-active-color: $primary-color;
  --calculated-paper-slider-height: 5px;
  transform: translateY(12px);
  }

  #progress-bar.ytmusic-player-bar[focused], ytmusic-player-bar:hover #progress-bar.ytmusic-player-bar {
  --paper-slider-knob-color: $primary-color;
  --paper-slider-knob-start-color: $primary-color;
  }

  /* make the knob diffrent */
  .slider-knob-inner.tp-yt-paper-slider {
    width: calc(100% - 26px) !important;
    height: calc(100% - 16px) !important;
    border-radius: 100px !important;
    position: absolute !important;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    margin: auto !important;
  }


  ytmusic-player-bar[player-fullscreened] #progress-bar.ytmusic-player-bar {width: 100%;}

  #sliderContainer.tp-yt-paper-slider {
  margin: 0 !important;
  height: calc(30px + var(--calculated-paper-slider-height));
  }

  .time-info {
    transform: translateY(7px);
    position: absolute;
    top: 0;
    margin: 0;
    padding: 0;
    border-radius: 50px;
    padding-bottom: 0px;
    margin-left: 16px !important;
  }

  .middle-controls { /* Make the player info on the left */
    grid-area: start !important;
    width: 35vw;
    justify-content: start !important;
    padding-left: 16px !important;
    overflow: visible;
    & .content-info-wrapper.ytmusic-player-bar {margin: 0 12px;}
  }

  .image.ytmusic-player-bar, .thumbnail-image-wrapper.ytmusic-player-bar {
    height: 60px;
  }

  // Make the text enter another row to save space
  .byline.style-scope.ytmusic-player-bar.complex-string {
    display: block;
    font-size: 1.25rem;
  }

  .byline.style-scope.ytmusic-player-bar.complex-string > span {
    display: none;
  }

  //.middle-controls-buttons.style-scope.ytmusic-player-bar {transform: translateX(50%);}

  // right media controls
  .right-controls.ytmusic-player-bar {
    margin: 0 16px 0 0;
  }
}
/* ======================
 *      Player Page
 * = *=====================  */
// fix playerpage transition
ytmusic-app-layout:not([is-mweb-modernization-enabled])>[slot=player-page] {
  transform: translate3d(0, 125vh, 0);
  transition: transform .5s var(--ease-out);
}

ytmusic-app-layout[player-page-open]>[slot=player-page] {
  transform: translate3d(0, 0, 0);
}

ytmusic-player[player-ui-state=MINIPLAYER] {
  bottom: calc(125vh + var(--ytmusic-mini-player-spacing));
}


#main-panel.style-scope.ytmusic-player-page {
padding: 0 !important;
}

ytmusic-app-layout:not([is-mweb-modernization-enabled]) > [slot="player-page"] {
  top: 0;
  height: calc(100vh - 100px);
}

ytmusic-player-page:not([is-mweb-modernization-enabled]):not([video-mode]) #player.ytmusic-player-page {/* Make the album rounded */
  overflow: visible;
}

#thumbnail, ytmusic-player[player-ui-state=MINIPLAYER][is-web-delhi-icons-enabled] { // round the big album art
box-shadow: 5px 5px 16px rgba(0,0,0,0.25);
border-radius: calc($border-radius);
overflow: hidden;
}

.song-media-controls.ytmusic-player {
  background: transparent;
}

.top-row-buttons.ytmusic-player > * {
  border-radius: 50%; /* Hover button on album art */
  width: 42px;
  height: 42px;
  box-shadow: 3px 3px 15px rgba(0, 0, 0, 0.5);
  background: rgba(0, 0, 0, 0.5);
  transition: scale 0.3s var(--bezier-hover);

  &:hover {
    scale: 1.2;
  }
}

// ======= Fullscreen Player page ====
ytmusic-player-page:not([is-mweb-modernization-enabled])[player-fullscreened]:not([blyrics-dfs]) #player.ytmusic-player-page {
  box-shadow: none ;
}

// The thing on the side of the album art
tp-yt-paper-tabs.ytmusic-player-page { // tab bar
  border-bottom: none;
  width: 50%;

  align-self: center;

  & [aria-disabled="true"] {opacity: 0.5;}
}
.tabs-content.scrollable.fit-container.tp-yt-paper-tabs {
  align-items: center;
}

tp-yt-paper-tab:nth-child(2).ytmusic-player-page { /* Add custom icons and yeah, this is the css way of it :/ */
  width: 23px;
  height: 23px !important;
  content: url('data:image/svg+xml;base64,');
}
tp-yt-paper-tab:nth-child(3).ytmusic-player-page {
  width: 23px;
  height: 23px !important;
  content: url(data:image/svg+xml;base64,);
}
tp-yt-paper-tab:nth-child(4).ytmusic-player-page {
  width: 23px;
  height: 23px !important;
  content: url(data:image/svg+xml;base64,);
}

tp-yt-paper-tab:nth-child(5).ytmusic-player-page {
  width: 23px;
  height: 23px !important;
  content: url(data:image/svg+xml;base64,);
}

.selection-bar.tp-yt-paper-tabs {
  border-bottom: 4px solid $primary-color;
  border-width: 3px !important;
}

ytmusic-player-queue-item { // the songs
  border-bottom: none;
}

ytmusic-player-queue-item[play-button-state="loading"], ytmusic-player-queue-item[play-button-state="paused"], ytmusic-player-queue-item[play-button-state="playing"] {
  background-color: $hover-bg;
  border-radius: $border-radius;

  overflow: hidden;

  padding: 0px 8px 0px 0px;

  &:before {
    content: "";
    display: inline;

    width: 8px;
    height: 100%;

    border-left: 4px solid $primary-color;
  }
}

// add fade effect
#tab-renderer {
-webkit-mask-image: linear-gradient(transparent, #000 50px, #000 calc(100% - 50px), transparent);
mask-image: linear-gradient(transparent, #000 50px, #000 calc(100% - 50px), transparent);
}

#tab-renderer > div > ytmusic-queue-header-renderer {
padding-top: 24px;
}


/* ======================
 *      Blyric stuff
 * = *=====================  */
ytmusic-player-page:before { /* Cool blured background with Blyrics! */
  background: var(--blyrics-background-img);
  background-size: cover;
  filter: brightness($background-album-brightness) blur($background-album-blur) saturate($background-album-saturation);
  object-fit: cover;
  object-position: center;
  transition: background 4s ease-out !important;
  inset: calc(0px - var(--ytmusic-nav-bar-height)) 0 0 calc(0px - var(--ytmusic-guide-width));
  height: 100vh;
  clip-path: inset(0);
}

#scrim.tp-yt-app-drawer:before {
background: var(--blyrics-background-img);
content: "";
position: absolute;
top: 0;
right: 0;
bottom: 0;
left: 0;

background-size: cover;
filter: brightness($background-album-brightness) blur($background-album-blur) saturate($background-album-saturation);
object-fit: cover;
object-position: center;
transition: background 4s ease-out !important;
height: 100vh;
clip-path: inset(0);

mask: linear-gradient(to bottom,rgba(0, 0, 0, 0.7) 0%, rgba(0, 0, 0, 0) 100%);

}



// PIP thingy
.blyrics-pip-backdrop {
  opacity: 1 !important;
}
.blyrics-pip-backdrop__layer {
  filter: brightness($background-album-brightness) blur($background-album-blur) saturate($background-album-saturation) !important;
}

// Footer at the end of the lyrics
.blyrics-footer {
  transform: scale(1) !important;
}
.blyrics-footer__container { /* Blyrics footer at the end of the lyrics */
  filter: saturate(0%);
  opacity: 0.25;
  transition: all 0.3s ease-out;
  &:hover {
    filter: saturate(100%);
    opacity: 1;
  }
}

@if $new-lyric-style == true {


  /* Make glow only show on long words */
  .blyrics--word::after {
    --blyrics-glow-color: color(display-p3 1 1 1 / 0.1);
  }

  .blyrics--word[data-long-word="true"]::after {
    --blyrics-glow-color: color(display-p3 1 1 1 / 1);
  }

  /* Padding */
  .blyrics-container > div {
    padding: 0.1em !important;
    padding-block: 0.65em !important;
  }

  .blyrics-container {
    padding-inline: 0.3em;
  }

  /* Add shadow to lyric*/
  .blyrics-bidi-run {
    text-shadow: 0 .3rem .5rem rgba(0, 0, 0, .15);
  }
  .blyrics-highlight-run {
    text-shadow: none;
  }

  .blyrics--line > .blyrics-background-line > .blyrics-bidi-run > .blyrics-background-lyric {
    font-size: 0.65em;
    font-weight: 500;
  }

  .blyrics-word-highlight[data-word-state="past"] {
    color: white;
    opacity: 1 !important;
  }

}

/* makes the music note 3 dots if enabled */
@if $custom-lyric-note == true {
  .blyrics--instrumental[data-agent="v1000"] .blyrics--instrumental-icon {
    margin-right: 68px;
    transform-origin: right center;
  }

  .blyrics--instrumental[data-agent="v2"] .blyrics--instrumental-icon, .blyrics--instrumental[data-agent="v3"] .blyrics--instrumental-icon {
    margin-right: 68px;
    transform-origin: 200% center;
  }



  .blyrics--line.blyrics--instrumental.blyrics--active.blyrics--animating > svg{
    animation: instrumental-break 3s ease-in-out infinite;
  }


  @keyframes instrumental-break {
    0% {
      transform: scale(1);
    }
    50% {
      transform: scale(0.9);
    }
    100% {
      transform: scale(1);
    }
  }


  .blyrics--instrumental-bg, .blyrics--instrumental-fill {
    d: var(--blyric-music-note-icon);
  }

  .blyrics--wave-rect {
    d: path("M -4 3.9 L 67 4 L 67 30 L -4 30 Z");
  }


  /*
   * .blyrics--animating.blyrics--paused > .blyrics--instrumental-icon, .blyrics--paused::before, .blyrics--paused::after {
   *   animation-play-state: paused !important;
}
}*/
}

@if $album-glow == true {
  ytmusic-player-page:not([is-mweb-modernization-enabled]):not([video-mode]) #player.ytmusic-player-page::before {
    content: "";
    filter: blur(64px) saturate(125%);
    scale: 1;
    background: var(--blyrics-background-img);
    background-size: cover !important;
    background-position: center;
    background-repeat: no-repeat;
    z-index: 0;
    min-width: 100%;

    transform: translateY(16px);
    opacity: 0.75;
  }
}

#better-lyrics-kawarp-player, #better-lyrics-kawarp-backdrop-player {
top: 0 !important;
}

// blyric dock
.blyrics-dock__inner {
  background: $heavy-transparent-bg;
  border: none;
  box-shadow: none;
  border-radius: $border-radius;

  opacity: 0.4;

  &:hover {opacity: 1;}
}

// Credit lyric thing
.blyrics-credits {
  transform: scale(1) !important;
}
