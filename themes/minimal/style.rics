:is(.blyrics-fs-like, .blyrics-fs-dislike) {
  --nudge-x: 0.626%;
  --nudge-y: -2.761%;
}

.blyrics-fs-like .blyrics-fs-rate-layer svg {
  transform: translate(var(--nudge-x), var(--nudge-y));
}

.blyrics-fs-dislike .blyrics-fs-rate-layer svg {
  transform: translate(calc(var(--nudge-x) * -1), calc(var(--nudge-y) * -1)) rotate(180deg);
}

/* ## SECTION-42 - PIP Portrait Layout and size ### */
main.blyrics-pip-shell:not([data-layout="stage"]) .blyrics-pip-artwork__controls {
  container-type: size;
  --blyrics-pip-control-size: clamp(0px, clamp(24px, 8vw, 36px), 22cqmin);
}

@media (max-aspect-ratio: 4/5) {
  /* minimum portrait artwork size */
  main.blyrics-pip-shell:not([data-layout="stage"]) {
    --pip-portrait-art-min: 160px;
  }

  main.blyrics-pip-shell[data-video="on"]:not([data-layout="stage"]) {
    --pip-portrait-art-min: 192px;
  }

  main.blyrics-pip-shell:not([data-layout="stage"]) {
    display: grid;
    grid-template-columns: clamp(var(--pip-portrait-art-min), 35%, 9999px) minmax(0, 1fr);
    grid-template-rows: auto minmax(0, 1fr);
    column-gap: 14px;
    row-gap: 10px;
    align-items: start;
    max-height: none;
  }

  main.blyrics-pip-shell:not([data-layout="stage"]) .blyrics-pip-art-col,
  main.blyrics-pip-shell:not([data-layout="stage"]) .blyrics-pip-content {
    display: contents;
  }

  main.blyrics-pip-shell:not([data-layout="stage"]) .blyrics-pip-artwork {
    grid-column: 1;
    grid-row: 1;
    align-self: start;
    width: 100%;
    min-width: 0;
    max-width: none;
    height: auto;
    aspect-ratio: var(--blyrics-pip-artwork-aspect, 1);
  }

  main.blyrics-pip-shell:not([data-layout="stage"]) .blyrics-pip-artwork__controls {
    --blyrics-pip-control-size: clamp(0px, clamp(36px, 13vw, 52px), 22cqmin);
  }

  main.blyrics-pip-shell:not([data-layout="stage"]) .blyrics-pip-header {
    grid-column: 2;
    grid-row: 1;
    align-self: start;
    min-width: 0;
    padding: 0;
  }
  main.blyrics-pip-shell:not([data-layout="stage"]) .blyrics-pip-header__title {
    font-size: clamp(15px, 4.8vw, 20px);
  }
  main.blyrics-pip-shell:not([data-layout="stage"]) .blyrics-pip-header__artist {
    font-size: clamp(11px, 3.4vw, 14px);
    margin-top: 0;
  }

  main.blyrics-pip-shell:not([data-layout="stage"]) .blyrics-pip-progress {
    grid-column: 2;
    grid-row: 1;
    align-self: end;
    min-width: 0;
  }

  main.blyrics-pip-shell:not([data-layout="stage"]) .blyrics-pip-lyrics {
    grid-column: 1/-1;
    grid-row: 2;
    align-self: stretch;
    min-height: 0;
  }
}

.blyrics-footer__discord.blyrics-footer__discord > img,
.blyrics-footer__discord.blyrics-footer__discord:hover > img {
  filter: none;
  transition: none;
}

/* ## SECTION-43 - Karaoke Subtitles ############### */
:root {
  --blyrics-karaoke-video-scale: 1;
  --blyrics-karaoke-plate-radius: 0.3em;
}

/* i accidentally dropped the plates on the floor and they cracked. sorry for you - play the song alexa */
#blyrics-karaoke .blyrics-karaoke__plate.blyrics-karaoke__plate {
  display: none !important;
  transition: initial !important;
  backdrop-filter: initial !important;
  -webkit-backdrop-filter: initial !important;
  box-shadow: initial !important;
}

#blyrics-karaoke .blyrics-karaoke__mount.blyrics-karaoke__mount {
  transition: initial !important;
  clip-path: none !important;
}

/* hither come my beloved, taste the soup */
.blyrics-container[data-layout="stage"] > .blyrics--line:not([data-blank="true"], [data-instrumental="true"]),
.blyrics-container[data-layout="stage"] > .blyrics-credits.blyrics-credits {
  --pip-stage-pad: var(--blyrics-karaoke-plate-padding-block, 0.18em);
  --pip-stage-r: var(--blyrics-karaoke-plate-radius, 0.46em);
  background: var(--filter-replacement-backgroundcolor);
  border-radius: var(--pip-stage-r);
  corner-shape: superellipse(2);
  outline: 1px solid var(--white-dot-10);
  outline-offset: -1px;
}

/* credits */
.blyrics-container[data-layout="stage"] > .blyrics-credits.blyrics-credits {
  --pip-stage-pad: var(--blyrics-karaoke-card-padding-block, 0.36em);
}

/* nothing to see here */
@media (max-aspect-ratio: 4/5) {
  .blyrics-pip-shell[data-layout="stage"] .blyrics-container[data-layout="stage"] > .blyrics--line:not([data-blank="true"], [data-instrumental="true"]),
  .blyrics-pip-shell[data-layout="stage"] .blyrics-container[data-layout="stage"] > .blyrics-credits.blyrics-credits {
    background: none;
    outline: none;
  }
}

/* no one is forgiven */
.blyrics-container[data-layout="stage"] > :is(.blyrics--line, .blyrics-credits) {
  filter: none !important;
}

/* sometimes i do forgive */
#blyrics-karaoke .blyrics-karaoke-surface {
  background: var(--filter-replacement-backgroundcolor);
 /* box-shadow: inset 0 0 0 1px var(--white-dot-10); */
  outline: 1px solid var(--white-dot-10);
  outline-offset: -1px;
  /* --blyrics-background-blur is a whole filter value, so it cannot go through calc(). */
  @if $enable-blur == on {
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }
  @else {
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }
}

/* ################################################ */


