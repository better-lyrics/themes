  60% {
    text-shadow:
      -2em -1.4em 32px oklch(from var(--energy-color) l c h / 0%),
      2.6em 0.1em 32px oklch(from var(--energy-color) l c h / 0%),
      1.8em 1.8em 32px oklch(from var(--energy-color) l c h / 0%),
      1.2em -2.3em 32px oklch(from var(--energy-color) l c h / 0%),
      -2.7em 0.3em 32px oklch(from var(--energy-color) l c h / 0%),
      -1.5em 2.2em 32px oklch(from var(--energy-color) l c h / 0%),
      2em -1.7em 32px oklch(from var(--energy-color) l c h / 0%),
      0 0 10px oklch(from var(--energy-color) l c h / 0%);
  }
  80% {
    opacity: .65;
    scale: 1.2333;
    text-shadow:
      -2em -1.4em 32px oklch(from var(--energy-color) l c h / 0%),
      2.6em 0.1em 32px oklch(from var(--energy-color) l c h / 0%),
      1.8em 1.8em 32px oklch(from var(--energy-color) l c h / 0%),
      1.2em -2.3em 32px oklch(from var(--energy-color) l c h / 0%),
      -2.7em 0.3em 32px oklch(from var(--energy-color) l c h / 0%),
      -1.5em 2.2em 32px oklch(from var(--energy-color) l c h / 0%),
      2em -1.7em 32px oklch(from var(--energy-color) l c h / 0%),
      0 0 10px oklch(from var(--energy-color) l c h / 0%);
  }
  100% {
    opacity: .45;
    scale: 1;
    text-shadow:
      -2em -1.4em 32px oklch(from var(--energy-color) l c h / 0%),
      2.6em 0.1em 32px oklch(from var(--energy-color) l c h / 0%),
      1.8em 1.8em 32px oklch(from var(--energy-color) l c h / 0%),
      1.2em -2.3em 32px oklch(from var(--energy-color) l c h / 0%),
      -2.7em 0.3em 32px oklch(from var(--energy-color) l c h / 0%),
      -1.5em 2.2em 32px oklch(from var(--energy-color) l c h / 0%),
      2em -1.7em 32px oklch(from var(--energy-color) l c h / 0%),
      0 0 10px oklch(from var(--energy-color) l c h / 0%);
  }
}

/* ### Section 30 - Layout & Navigation Transitions */
/*
#content-wrapper {
  transition-duration: 0.7s;
  transition-property: margin;
  transition-timing-function: var(--transition-curve);
}
*/ /* disabling for potential performance issues */

#contentContainer {
  transition-duration: 0.35s !important;
  /* transition-property: visibility, width, transform; */
  /* disabling for potential performance issues */
  transition-property: visibility, transform;
  transition-timing-function: var(--transition-curve);
}
/*
ytmusic-player-page#player-page {
  transition-duration: 0.35s, 0.35s, 0.7s !important;
  transition-property: left, transform, width;
  transition-timing-function: var(--transition-curve);
} */ /* disabling for potential performance issues */
/*
.content-container.ytmusic-immersive-header-renderer {
  transition-duration: 0.7s !important;
  transition-property: width;
  transition-timing-function: var(--transition-curve);
}
*/ /* disabling for potential performance issues */
/*
#header
  > ytmusic-immersive-header-renderer
  > ytmusic-fullbleed-thumbnail-renderer {
  transition-duration: 1.05s !important;
  transition-property: margin, transform;
  transition-timing-function: var(--transition-curve);
}
*/ /* disabling for potential performance issues */
ytmusic-app-layout.content-scrolled #mini-guide-background.ytmusic-app-layout,
ytmusic-app-layout[player-page-open] #mini-guide-background.ytmusic-app-layout {
    opacity: 0;
}

tp-yt-paper-item.ytmusic-guide-entry-renderer {
  opacity:0.7;
  transition: none;
    
    &:hover{
    background-color: var(--white-dot-10);
    /*box-shadow: inset 0 0 0px 1px var(--white-dot-10);*/
    outline: 1px solid var(--white-dot-10);
    outline-offset: -1px;
    opacity:1;
    }
}

ytmusic-guide-entry-renderer[active] tp-yt-paper-item.ytmusic-guide-entry-renderer {
  background-color: var(--white-dot-10);
  /*box-shadow: inset 0 0 0px 1px var(--white-dot-10);*/
  outline: 1px solid var(--white-dot-10);
  outline-offset: -1px;
  opacity: 0.87;
  transition: none;

  &:hover {
    opacity: 1;
    background-color: var(--white-dot-15);
    /*box-shadow: inset 0 0 0px 1px var(--white-dot-15);*/
    outline: 1px solid var(--white-dot-15);
    outline-offset: -1px;
  }
}

