      2.6em 0.1em 32px oklch(from var(--energy-color) l c h / 0%),
      1.8em 1.8em 32px oklch(from var(--energy-color) l c h / 0%),
      1.029em -1.971em 28.143px oklch(from var(--energy-color) l c h / 11.429%),
      -1.157em 0.129em 16.571px oklch(from var(--energy-color) l c h / 45.714%),
