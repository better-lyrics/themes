      1.8em 1.8em 32px oklch(from var(--energy-color) l c h / 0%),
      1.2em -2.3em 32px oklch(from var(--energy-color) l c h / 0%),
      -1.543em 0.171em 20.429px oklch(from var(--energy-color) l c h / 34.286%),
      -0.214em 0.314em 8.857px oklch(from var(--energy-color) l c h / 68.571%),
      0 0 5px oklch(from var(--energy-color) l c h / 0%),
