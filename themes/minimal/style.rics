      0.686em -1.314em 20.429px oklch(from var(--energy-color) l c h / 34.286%),
      -0.386em 0.043em 8.857px oklch(from var(--energy-color) l c h / 68.571%),
      0 0 5px oklch(from var(--energy-color) l c h / 0%),
      0 0 5px oklch(from var(--energy-color) l c h / 0%),
