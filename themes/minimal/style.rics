/* ### Section 32 - Progress bar and knob ######### */
#hover-time-info.ytmusic-player-bar {
  background-color: var(--white-dot-87);
  color: var(--black-dot-87);
  font-size: 13px;
  font-weight: 500;
  padding: 5px 12px;
  border-radius: 20.88px;
  corner-shape: superellipse(1.2);
  top: -42px;
  transform: translateX(-50%);
  box-shadow: 0 4px 12px var(--black-dot-20);
}

tp-yt-paper-slider {
  --paper-progress-active-color: var(--white-dot-60);
  --paper-progress-secondary-color: var(--white-dot-10);
}

#progress-bar.ytmusic-player-bar[focused],
#progress-bar.ytmusic-player-bar,
ytmusic-player-bar[player-fullscreened] #progress-bar.ytmusic-player-bar,
ytmusic-player-bar:hover #progress-bar.ytmusic-player-bar,
#progress-bar.ytmusic-player-controls {
  --paper-slider-knob-color: var(--white-dot-60);
  --paper-slider-knob-start-color: var(--white-dot-60);
  --paper-slider-knob-start-border-color: var(--white-dot-60);
  --paper-slider-container-color: var(--white-dot-10);
  --paper-slider-active-color: var(--paper-progress-active-color);
  --paper-slider-secondary-color: var(--paper-progress-secondary-color);
}

#progress-bar.ytmusic-player-bar {
  --paper-slider-knob-color: transparent;
  --paper-slider-knob-start-color: transparent;
  --paper-slider-knob-start-border-color: transparent;
}

ytmusic-player-bar[is-mweb-player-bar-modernization-enabled]
  #progress-bar.ytmusic-player-bar,
ytmusic-player-bar[is-mweb-player-bar-modernization-enabled]
  #progress-bar.ytmusic-player-bar[focused] {
  --paper-slider-disabled-active-color: var(--white-dot-87);
  --paper-slider-disabled-secondary-color: var(--white-dot-10);
  --paper-slider-disabled-knob-color: transparent;
  --paper-slider-container-color: var(--white-dot-10);
  --paper-slider-knob-color: transparent;
  --paper-slider-knob-start-color: transparent;
  --paper-slider-knob-start-border-color: transparent;
}

.slider-knob-inner.tp-yt-paper-slider {
  width: calc(100% - 10px) !important;
  height: calc(100% - 20px) !important;
  border-radius: 999rem !important;
  corner-shape: superellipse(1.2) !important;
  position: absolute !important;
  top: 0;
  bottom: 0;
  left: 0;
  right: 0;
  margin: auto !important;
}
/*
.slider-knob.tp-yt-paper-slider {
  transition: left 0.25s cubic-bezier(0.0, 0.0, 0.2, 1);
  will-change: left;
  transform: translateZ(0);
}
*/
 /* disabling for potential performance issues */
/*
#primaryProgress.tp-yt-paper-progress,
#secondaryProgress.tp-yt-paper-progress {
  transition: transform 0.25s cubic-bezier(0.0, 0.0, 0.2, 1);
}
*/
.time-info.ytmusic-player-bar,
.current-time.ytmusic-player-controls,
.total-time.ytmusic-player-controls {
  color: var(--white-dot-87) !important;
  font-weight: 200 !important;
}

/* ### Section 33 - Audio-Video toggle ############ */
#av-id {
  .av-toggle.ytmusic-av-toggle {
    background-color: var(--white-dot-10);
    border: none;
    /*box-shadow: inset 0 0 0px 1px var(--white-dot-10);*/
    outline: 1px solid var(--white-dot-10);
    outline-offset: -1px;
    display: inline-flex;
    overflow: hidden;
    corner-shape: superellipse(1.2);

    button {
      corner-shape: superellipse(1.2);
      border: none;
    }
    
    ytmusic-app-layout[player-ui-state="FULLSCREEN"] & {
      background-color: var(--black-dot-60);
      /*box-shadow: inset 0 0 0px 1px var(--black-dot-60);*/
      outline: 1px solid var(--black-dot-60);
      outline-offset: -1px;
      border: none;
    }
  }

  ytmusic-av-toggle {
    opacity: 0.6;
    transition: opacity 0.3s var(--transition-curve);

    &:hover {
      opacity: 0.87;
    }

    :is(.song-button, .video-button)[aria-pressed="true"] {
      background-color: var(--white-dot-15);
      color: var(--white-1);
      /*box-shadow: inset 0 0 0px 1px var(--white-dot-10);*/
      outline: 1px solid var(--white-dot-10);
      outline-offset: -1px;
    }

    &[toggle-disabled] {
      opacity: 0.1;

      &:hover {
        opacity: 0.4;
      }

      button.ytmusic-av-toggle {
        cursor: default;

        &[aria-pressed="false"] {
          color: var(--white-dot-15);
        }
      }
    }
  }

  :is(.song-button, .video-button).ytmusic-av-toggle {
    background-color: transparent;
    color: var(--white-dot-60);
    border: none;
    margin: 0;
    cursor: pointer;
    transition: background-color 0.2s var(--transition-curve),
      color 0.2s var(--transition-curve);
  }
}

@media (min-width: 1364px) and (max-width: 1577px) {
  ytmusic-player-page {
    --ytmusic-player-page-vertical-padding: calc(40px * 0.4);
  }
}

/* ### Section 34 - Play-next buttons ############# */
.play-pause-button-wrapper.ytmusic-player-controls {
  background-color: var(--white-dot-10);
  /*box-shadow: inset 0 0 0px 1px var(--white-dot-10);*/
  outline: 1px solid var(--white-dot-10);
  outline-offset: -1px;
  opacity: 0.87;
  transition: none;

  &:hover {
    opacity: 1;
    background-color: var(--white-dot-15);
    /*box-shadow: inset 0 0 0px 1px var(--white-dot-15);*/
    outline: 1px solid var(--white-dot-15);
    outline-offset: -1px;
  }
}

.yt-icon:where(.yt-icon-container),
.yt-icon:where(.ytIconWrapperHost),
yt-icon {
  color: var(--white-1);
  
  &:hover {
    opacity: 1;
  }
}

#button:not(ytmusic-responsive-header-renderer #button) > yt-icon > span {
  opacity: 0.87;

  &:hover {
    opacity: 1;
  }
}

ytmusic-player-controls[is-web-delhi-icons-enabled]:not([player-fullscreened])
  .next-button.ytmusic-player-controls,
ytmusic-player-controls[is-web-delhi-icons-enabled]:not([player-fullscreened])
  .previous-button.ytmusic-player-controls,
ytmusic-player-controls[is-web-delhi-icons-enabled]:not([player-fullscreened])
  .seek-back-button.ytmusic-player-controls,
ytmusic-player-controls[is-web-delhi-icons-enabled]:not([player-fullscreened])
  .seek-forward-button.ytmusic-player-controls,
ytmusic-player-controls[is-web-delhi-icons-enabled]:not([player-fullscreened])
  .repeat.ytmusic-player-controls,
ytmusic-player-controls[is-web-delhi-icons-enabled]:not([player-fullscreened])
  .shuffle.ytmusic-player-controls,
ytmusic-player-bar[is-web-delhi-icons-enabled]
  yt-icon-button.ytmusic-player-bar,
.middle-controls-buttons .ytSpecButtonShapeNextMono.ytSpecButtonShapeNextText,
#top-level-buttons .ytSpecButtonShapeNextMono.ytSpecButtonShapeNextText,
ytmusic-menu-renderer:not(ytmusic-responsive-header-renderer ytmusic-menu-renderer) #button-shape > button {
  opacity: 0.7;
  transition: none;
  border-radius: 50%;

  &:hover {
    background-color: var(--white-dot-10);
    /*box-shadow: inset 0 0 0px 1px var(--white-dot-10);*/
    outline: 1px solid var(--white-dot-10);
    outline-offset: -1px;
    border-radius: 50%;
    opacity: 1;
  }
}

/* ## SECTION-35 - Album & Playlist Header Buttons# */
ytmusic-responsive-header-renderer[is-album-detail-page][num-header-buttons="3"]
  .action-buttons.ytmusic-responsive-header-renderer
  .ytmusic-responsive-header-renderer:not(:nth-child(2)),
ytmusic-responsive-header-renderer[is-album-detail-page][num-header-buttons="3"]
  .action-buttons.ytmusic-responsive-header-renderer
  yt-button-renderer.ytmusic-responsive-header-renderer:nth-child(2),
ytmusic-responsive-header-renderer[is-album-detail-page][num-header-buttons="4"]
  .action-buttons.ytmusic-responsive-header-renderer
  > .ytmusic-responsive-header-renderer,
ytmusic-responsive-header-renderer[is-album-detail-page][num-header-buttons="5"]
  .action-buttons.ytmusic-responsive-header-renderer
  .ytmusic-responsive-header-renderer:not(:nth-child(3)),
ytmusic-responsive-header-renderer[is-playlist-detail-page][num-header-buttons="3"]
  .action-buttons.ytmusic-responsive-header-renderer
  .ytmusic-responsive-header-renderer:not(:nth-child(2)),
ytmusic-responsive-header-renderer[is-playlist-detail-page][num-header-buttons="3"]
  .action-buttons.ytmusic-responsive-header-renderer
  yt-button-renderer.ytmusic-responsive-header-renderer:nth-child(2),
ytmusic-responsive-header-renderer[is-playlist-detail-page][num-header-buttons="4"]
  .action-buttons.ytmusic-responsive-header-renderer
  > .ytmusic-responsive-header-renderer,
ytmusic-responsive-header-renderer[is-playlist-detail-page][num-header-buttons="5"]
  .action-buttons.ytmusic-responsive-header-renderer
  .ytmusic-responsive-header-renderer:not(:nth-child(3)) {
  background: transparent;
  /*box-shadow: inset 0 0 0px 1px var(--white-dot-15);*/
  outline: 1px solid var(--white-dot-15);
  outline-offset: -1px;

  &:hover {
    background: var(--white-dot-10);
    /*box-shadow: inset 0 0 0px 1px var(--white-dot-15);*/
    outline: 1px solid var(--white-dot-15);
    outline-offset: -1px;
  }
}

ytmusic-responsive-header-renderer
  #action-buttons
  > ytmusic-play-button-renderer {
  background-color: var(--white-dot-10);
  /*box-shadow: inset 0 0 0px 1px var(--white-dot-10);*/
  outline: 1px solid var(--white-dot-10);
  outline-offset: -1px;
  opacity: 0.87;
  &:hover {
    background-color: var(--white-dot-15);
    /*box-shadow: inset 0 0 0px 1px var(--white-dot-15);*/
    outline: 1px solid var(--white-dot-15);
    outline-offset: -1px;
    opacity: 1;
  }
}

ytmusic-responsive-header-renderer
  #action-buttons
  > :not(ytmusic-play-button-renderer) {
  opacity: 0.87;

  &:hover {
    opacity: 1;
  }

  & yt-icon > span {
    opacity: inherit !important;
  }
}

ytmusic-responsive-header-renderer
  .ytSpecButtonShapeNextMono.ytSpecButtonShapeNextText:hover {
  background: transparent;
  background-color: transparent;
}

ytmusic-responsive-header-renderer .icon.ytmusic-play-button-renderer {
  color: inherit;
}

/* ## SECTION-36 - Track Lists #################### */

#contents > ytmusic-responsive-list-item-renderer {
  box-shadow: none;
  border-radius: 13.92px;
  corner-shape: superellipse(2);
  border: none !important;

  &:hover {
    background: var(--white-dot-10);
    /*box-shadow: inset 0 0 0px 1px var(--white-dot-15);*/
    outline: 1px solid var(--white-dot-15);
    outline-offset: -1px;
  }

  & .secondary-flex-columns.ytmusic-responsive-list-item-renderer .flex-column.ytmusic-responsive-list-item-renderer {
    font-weight: 200;
  }
}

/* ## SECTION-37 - Blyrics Dock ################### */
.blyrics-dock {
  transition: transform 125ms cubic-bezier(0.4, 0, 0.2, 1);
}

.blyrics-dock__inner {
  background-color: var(--white-dot-10);
  background: oklch(from var(--youtube-gray-212121) l c h / 0.75);
  box-shadow: none;
  outline: 1px solid var(--white-dot-15);
  outline-offset: -1px;
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
  transition:
    transform 320ms cubic-bezier(0.4, 0, 0.2, 1),
    opacity 320ms cubic-bezier(0.4, 0, 0.2, 1),
    background-color 200ms ease;
}

.blyrics-dock__inner:hover,
.blyrics-dock__inner:focus-within,
.blyrics-dock__inner--expanded {
  background-color: var(--black-dot-87);
  background: var(--youtube-gray-212121);
}

.blyrics-dock--hidden .blyrics-dock__inner,
#layout[player-fullscreened]:not([blyrics-dfs]) .blyrics-dock--idle-hidden .blyrics-dock__inner {
  filter: none;
}

.blyrics-dock__divider {
  background-color: var(--white-dot-10);
}

.blyrics-dock__control,
.blyrics-dock__cycle,
.blyrics-dock__offset-step,
.blyrics-dock__offset-row-step {
  color: var(--white-dot-87);
  transition:
    background-color 160ms cubic-bezier(0.4, 0, 0.2, 1),
    color 160ms cubic-bezier(0.4, 0, 0.2, 1);
}

.blyrics-dock__control:hover,
.blyrics-dock__cycle:hover,
.blyrics-dock__offset-step:hover,
.blyrics-dock__offset-row-step:hover {
  background-color: var(--white-dot-15);
  color: var(--white-1);
}

.blyrics-dock__control--active {
  box-shadow: none;
  outline: 1px solid color-mix(in srgb, var(--dock-pill-accent, hsl(45, 100%, 56%)) 30%, transparent);
  outline-offset: -1px;
}

.blyrics-dock__control--active:hover {
  box-shadow: none;
  outline: 1px solid color-mix(in srgb, var(--dock-pill-accent, hsl(45, 100%, 56%)) 45%, transparent);
  outline-offset: -1px;
}

.blyrics-dock__cycle,
.blyrics-dock__offset-step {
  transition:
    background-color 160ms cubic-bezier(0.4, 0, 0.2, 1),
    color 160ms cubic-bezier(0.4, 0, 0.2, 1),
    max-width 240ms cubic-bezier(0.4, 0, 0.2, 1),
    opacity 240ms cubic-bezier(0.4, 0, 0.2, 1);
}

.blyrics-dock__fx {
  transition:
    transform 320ms cubic-bezier(0.4, 0, 0.2, 1),
    opacity 320ms cubic-bezier(0.4, 0, 0.2, 1),
    width 320ms cubic-bezier(0.4, 0, 0.2, 1);
}

.blyrics-dock__fx-out {
  filter: none;
}

.blyrics-dock__source {
  color: var(--white-dot-87);
}

.blyrics-dock__source-position {
  color: var(--white-dot-87);
}

.blyrics-dock__menu {
  background-color: var(--black-dot-87);
  background: var(--youtube-gray-212121);
  box-shadow: none;
  outline: 1px solid var(--white-dot-15);
  outline-offset: -1px;
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
}

.blyrics-dock__menu-item {
  color: var(--white-dot-87);
}

.blyrics-dock__menu-item:hover {
  background-color: var(--white-dot-10);
  color: var(--white-1);
}

/* --- Offset control --- */
.blyrics-dock__offset {
  color: var(--white-dot-87);
}

.blyrics-dock__offset-icon:hover {
  background-color: var(--white-dot-15);
}

.blyrics-dock__offset-value {
  color: var(--white-dot-87);
}

.blyrics-dock__offset-row-label {
  color: var(--white-dot-87);
}

.blyrics-dock__offset-reset {
  background-color: var(--white-dot-10);
  color: var(--white-dot-87);
}

.blyrics-dock__offset-reset:hover {
  background-color: var(--white-dot-15);
  color: var(--white-1);
}

@keyframes blyrics-dock-offset-flash-up {
  0% {
    color: var(--dock-accent, hsl(45, 95%, 65%));
    transform: scale(1.22);
  }
  100% {
    color: var(--white-dot-87);
    transform: scale(1);
  }
}

@keyframes blyrics-dock-offset-flash-down {
  0% {
    color: var(--dock-accent, hsl(45, 95%, 65%));
    transform: scale(0.8);
  }
  100% {
    color: var(--white-dot-87);
    transform: scale(1);
  }
}

/* ## SECTION-38 - Autoscroll Resume button ####### */
.autoscroll-resume-button {
  background: var(--youtube-gray-212121);
  opacity: 0.75;
  border: none;
  outline: 1px solid var(--white-dot-20);
  outline-offset: -1px;
  color: var(--white-dot-87);
  font-weight: 500;
  backdrop-filter: none;
  will-change: auto;

  transition:
    opacity 0.1s linear 0.1s,
    transform 0.2s cubic-bezier(0.5, 1, 0.89, 1);
}

.autoscroll-resume-button:hover {
  text-shadow: none;
  opacity: 1;
  color: var(--white-1);
}

.autoscroll-resume-button:hover[autoscroll-hidden="true"] {
  text-shadow: none;
  opacity: 0;
  color: var(--white-1);
}

.autoscroll-resume-button:focus {
  outline-color: var(--white-dot-20);
  outline: 1px solid var(--white-dot-20);
  outline-offset: -1px;
}

/* ## SECTION-39 - Picture-In-Picture - PIP ####### */
/*# SECTION-39.1 - Variables ################## */
.blyrics-pip-shell.blyrics-pip-shell {
  --blyrics-pip-artwork-shadow: none;
  --pip-blank: url("data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7");
  --pip-blank: url("https://raw.githubusercontent.com/ramansg/Minimal/refs/heads/main/piqsels.com-id-zhync.webp");
  --pip-art-hold: 20s;
  --pip-art-fade-duration: 0.6s;
}

/*# SECTION-39.2 - Backdrop ################### */
.blyrics-pip-backdrop.blyrics-pip-backdrop {
  opacity: 1 !important;
  background-image: var(--blyrics-pip-art, var(--pip-blank));
  background-color: var(--filter-replacement-backgroundcolor);
  background-blend-mode: overlay;
  background-position: 50%;
  background-size: cover;
  transform: scale(1.2);
  filter: var(--blyrics-background-blur);
}

/* begone */
.blyrics-pip-backdrop__layer.blyrics-pip-backdrop__layer {
  display: none !important;
}

@media (prefers-reduced-motion: no-preference) {
  .blyrics-pip-backdrop.blyrics-pip-backdrop {
    transition: var(--background-image-transition);
  }

  .blyrics-pip-shell:has(.blyrics-pip-artwork:not([data-has-art="true"]))
    .blyrics-pip-backdrop.blyrics-pip-backdrop {
    transition-delay: var(--pip-art-hold);
  }
}

/*# SECTION-39.3 - Artwork #################### */
/* gotta do it to em */
.blyrics-pip-shell .blyrics-pip-artwork {
  overflow: hidden !important;
  perspective: none !important;
}

/* outlining */
.blyrics-pip-shell .blyrics-pip-artwork::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 5;
  border-radius: inherit;
  corner-shape: inherit;
  outline: 1px solid var(--white-dot-10);
  outline-offset: -1px;
  pointer-events: none;
}

.blyrics-pip-shell .blyrics-pip-artwork__card {
  transform: none !important;
  transform-style: flat !important;
  transition: none !important;
  animation: none !important;
}

.blyrics-pip-shell .blyrics-pip-artwork__face {
  transform: none !important;
  backface-visibility: visible !important;
}

.blyrics-pip-shell .blyrics-pip-artwork__face {
  background: none;
}

/* baby show up proud */
.blyrics-pip-shell .blyrics-pip-artwork__image {
  opacity: 1 !important;
}

.blyrics-pip-shell .blyrics-pip-artwork__placeholder {
  display: none !important;
}

.blyrics-pip-shell[blyrics-pip-transition="flip"]
  .blyrics-pip-artwork__face[data-front="true"],
.blyrics-pip-shell[blyrics-pip-transition="shuffle"]
  .blyrics-pip-artwork__face[data-front="true"],
.blyrics-pip-shell[blyrics-pip-transition="shuffle"][data-running="true"]
  .blyrics-pip-artwork__face,
.blyrics-pip-artwork {
  box-shadow: none !important;
}

.blyrics-pip-artwork.blyrics-pip-artwork,
.blyrics-pip-artwork__face.blyrics-pip-artwork__face,
.blyrics-pip-artwork__controls.blyrics-pip-artwork__controls {
  --blyrics-pip-artwork-radius: 1em;
  border-radius: 1em !important;
  corner-shape: superellipse(2);
}

.blyrics-pip-artwork__music-video.blyrics-pip-artwork__music-video {
  corner-shape: inherit;
}

/*# SECTION-39.4 - Artwork Controls ########### */
/* backround when controls hovered - scrim */
.blyrics-pip-artwork__controls.blyrics-pip-artwork__controls {
  background: var(--filter-replacement-backgroundcolor);
  /* background of controls and song/video */
  --blyrics-pip-control-tint: var(--white-dot-10);
  --blyrics-pip-control-backdrop: none;
  /* transition: none; */
}

/* here's how them folks get down and dirty (ought to replicate)
 *   none             --white-dot-10
 *   hover            --white-dot-15
 *   pressed (active) --white-dot-20
 *   keyboard focus   --white-dot-25  (focus-visible; 2px;)
 *   focus + hover    --white-dot-30  (or focus + pressed)

 * current default look in this system: 1px outline on transparent background */

/* prev / next / whatevs */
.blyrics-pip-shell .blyrics-pip-artwork__control.blyrics-pip-artwork__control {
  --pip-control-tone: var(--white-dot-10);
  background: oklch(1 0 0 / 0);
  outline: 1px solid var(--pip-control-tone);
  outline-offset: -1px;
  opacity: 0.7;
  transition: none;

  &::before {
    display: none;
  }

  &:hover {
    --pip-control-tone: var(--white-dot-15);
    background-color: var(--pip-control-tone);
    opacity: 1;
  }

  &:active {
    --pip-control-tone: var(--white-dot-20);
    background-color: var(--pip-control-tone);
    opacity: 1;
  }

  &:focus-visible {
    --pip-control-tone: var(--white-dot-25);
    background-color: var(--pip-control-tone);
    outline-width: 2px;
    outline-offset: -2px;
    opacity: 1;
  }

  &:focus-visible:is(:hover, :active) {
    --pip-control-tone: var(--white-dot-30);
  }
}

/* play / pause */
.blyrics-pip-shell .blyrics-pip-artwork__control.blyrics-pip-artwork__control--play-pause {
  color: var(--white-1);
  background-color: var(--pip-control-tone);
  opacity: 0.87;
}

/* song / video pill and close button (v3.0.0+) */
.blyrics-pip-shell .blyrics-pip-mode-toggle.blyrics-pip-mode-toggle {
  outline: 1px solid var(--white-dot-10);
  outline-offset: -1px;
}

/* sure... yays */
.blyrics-pip-shell .blyrics-pip-mode-toggle__option.blyrics-pip-mode-toggle__option {
  --pip-control-tone: var(--white-dot-10);
  color: var(--white-dot-60);
  background: oklch(1 0 0 / 0);
  transition: none;

  &:hover {
    --pip-control-tone: var(--white-dot-15);
    background-color: var(--pip-control-tone);
    color: var(--white-1);
  }

  &:active {
    --pip-control-tone: var(--white-dot-25);
    background-color: var(--pip-control-tone);
    color: var(--white-1);
  }

  &[aria-pressed="true"] {
    --pip-control-tone: var(--white-dot-20);
    background-color: var(--pip-control-tone);
    color: var(--white-1);

    &:hover,
    &:active {
      --pip-control-tone: var(--white-dot-25);
    }
  }

  &:focus-visible {
    outline: 2px solid var(--white-dot-25);
    outline-offset: -2px;
    color: var(--white-1);

    &:hover,
    &:active {
      outline-color: var(--white-dot-30);
    }
  }
}

/* prev next click animation */
.blyrics-pip-shell .blyrics-control-nudge-prev svg,
.blyrics-pip-shell .blyrics-control-nudge-next svg {
 /* animation: none; */
}

.blyrics-pip-shell .blyrics-control-ripple-layer {
  display: none;
}

/*# SECTION-39.5 - Artwork Crossfade ########## */
/* two faced like the angel */
.blyrics-pip-shell .blyrics-pip-artwork__face[data-front="false"] {
  visibility: hidden;
}

@media (prefers-reduced-motion: no-preference) {
  .blyrics-pip-shell .blyrics-pip-artwork__face[data-front="true"] {
    animation: pip-art-fade var(--pip-art-fade-duration) ease both !important;
  }

  .blyrics-pip-shell .blyrics-pip-artwork__face[data-front="false"] {
    animation: pip-art-hold-back var(--pip-art-fade-duration) linear !important;
  }
}

@keyframes pip-art-fade {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

@keyframes pip-art-hold-back {
  from, to { visibility: visible; }
}

/*# SECTION-39.6 - Progress Bar ############### */
.blyrics-progress {
  --blyrics-progress-track: var(--white-dot-10);
  --blyrics-progress-dot-shadow: none;
}

.blyrics-progress__bar {
  height: 2px;
}

.blyrics-progress__bar.dragging {
  /* box-shadow: 0 0 0 1px var(--white-dot-60); */
  outline: 1px solid var(--white-dot-60);
  outline-offset: 0px;
}

.blyrics-progress__fill {
  background: var(--white-dot-60);
}

.blyrics-progress__knob-dot.blyrics-progress__knob-dot {
  width: calc(100%) !important;
  height: calc(55%) !important;
  border-radius: 999rem !important;
  corner-shape: superellipse(1.2) !important;
  background: var(--white-dot-60);
  outline: 1px solid var(--white-dot-60);
  outline-offset: -1px;
  visibility: hidden;
}

.blyrics-progress__bar.blyrics-progress__bar:hover .blyrics-progress__knob-dot.blyrics-progress__knob-dot {
  box-shadow: none;
  visibility: visible;
}

/* why even */
.blyrics-progress__times,
.blyrics-progress__end {
  font-variant-numeric: unset;
  font-weight: 200;
}

/*# SECTION-39.7 - Title Text ################# */

/* animation only on hover - shenanigans */
.blyrics-pip-header:not(:hover) .blyrics-pip-line[data-marquee="read"] {
  animation-name: none !important;
}

.blyrics-pip-header:hover .blyrics-pip-line[data-marquee="read"] {
  --pip-marquee-speed: 1.5;
  --pip-marquee-hover-delay: 250ms;
  animation-duration: calc(var(--blyrics-pip-marquee-cycle) / var(--pip-marquee-speed));
  animation-delay: calc(var(--pip-marquee-hover-delay) - 1500ms / var(--pip-marquee-speed));
}

.blyrics-pip-line[data-overflows] {
  transition: none !important;
}

.blyrics-pip-line__unit {
  animation: none !important;
  transform: none !important;
  opacity: 1 !important;
}

.blyrics-pip-line[data-swapping="true"]
  .blyrics-pip-line__layer[data-front="true"],
.blyrics-pip-line[data-swapping="true"]
  .blyrics-pip-line__layer[data-front="false"] {
  animation: none !important;
}

.blyrics-pip-line[data-swapping="true"]
  .blyrics-pip-line__layer[data-front="false"] {
  opacity: 0 !important;
}

/*# SECTION-39.8 - Loader ##################### */
/* mess */
.blyrics-pip-loader__mark.blyrics-pip-loader__mark {
  animation: blyrics-shimmer 1s infinite alternate ease-in-out;
  width: 1em;
  height: 1em;
}

.blyrics-pip-loader__label.blyrics-pip-loader__label {
  background: unset;
  -webkit-background-clip: unset;
  background-clip: unset;
  color: var(--white-1);
  font-size: 1em;
  line-height: 1.5;
  animation: blyrics-shimmer 1s infinite alternate ease-in-out;
}

.blyrics-pip-loader.blyrics-pip-loader {
  opacity: 1;
  transition: opacity var(--blyrics-loader-transition-duration, 0.6s)
    var(--blyrics-loader-transition-easing);
}

@starting-style {
  .blyrics-pip-loader.blyrics-pip-loader {
    opacity: 0;
  }
}

/*# SECTION-39.9 - Ad ######################### */
/* the same old love */
.blyrics-pip-intermission__mark.blyrics-pip-intermission__mark {
  animation: blyrics-shimmer 1s infinite alternate ease-in-out;
}

.blyrics-pip-intermission__label.blyrics-pip-intermission__label {
  background: unset;
  -webkit-background-clip: unset;
  background-clip: unset;
  color: var(--white-1);
  animation: blyrics-shimmer 1s infinite alternate ease-in-out;
}

/*# SECTION-39.10 - Video Stage ################ */

/* rounded corners- i never knew ya */
.blyrics-pip-shell[data-layout="stage"] .blyrics-pip-artwork__controls.blyrics-pip-artwork__controls {
  border-radius: 0 !important;
  /* my colors in you */
  background: linear-gradient(
    to bottom in oklch,
    var(--filter-replacement-backgroundcolor),
    oklch(from var(--filter-replacement-backgroundcolor) l c h / 0.5) 32%,
    oklch(from var(--filter-replacement-backgroundcolor) l c h / 0.5) 62%,
    var(--filter-replacement-backgroundcolor)
  );
}

/* hide away, the video is playing */
.blyrics-pip-shell[data-layout="stage"] .blyrics-pip-backdrop.blyrics-pip-backdrop {
  background-color: var(--black-1);
}

/* was something there */
.blyrics-pip-shell[data-layout="stage"] .blyrics-pip-artwork::after {
  display: none;
}

/* ## SECTION-40 - Unison ######################### */
.blyrics-gam__featured,
.blyrics-gam__seal,
.blyrics-gam__tier,
.blyrics-gam__ring,
.blyrics-footer__unison-score-line {
  max-height: 0;
  opacity: 0;
  overflow: hidden;
  white-space: nowrap;
  pointer-events: none;

  transition:
    max-width 0.35s cubic-bezier(0.4, 0, 0.2, 1),
    max-height 0.35s cubic-bezier(0.4, 0, 0.2, 1),
    margin 0.35s cubic-bezier(0.4, 0, 0.2, 1),
    padding 0.35s cubic-bezier(0.4, 0, 0.2, 1),
    opacity 0.25s ease;
  transition-delay: 0.3s;
}

.blyrics-gam__featured,
.blyrics-gam__tier {
  max-width: 0;
  margin-left: -10px;
  padding: 0;
}

.blyrics-gam__ring {
  max-width: 0;
  margin-right: -10px;
  padding: 0;
}

.blyrics-gam__seal {
  max-width: 0;
  margin-top: -10px;
  padding: 0;
}

.blyrics-footer__unison-score-line {
  max-width: 100%;
  margin-top: -0.5rem;
}

.blyrics-footer__unison-author:hover {
  & .blyrics-gam__featured,
  & .blyrics-gam__seal,
  & .blyrics-gam__tier,
  & .blyrics-gam__ring {
    max-width: 400px;
    max-height: 40px;
    opacity: 1;
    pointer-events: auto;
  }

  & .blyrics-gam__featured,
  & .blyrics-gam__tier {
    margin-left: 0;
  }

  & .blyrics-gam__ring {
    margin-right: 0;
  }

  & .blyrics-gam__seal {
    margin-top: 0;
    padding: 0 10px 0 0;
  }

  & .blyrics-gam__tier {
    padding: 0 12px 0 7px;
  }
}

/* Ring-a-ring of roses */
.blyrics-footer__unison-author:hover .blyrics-gam__ring--avatar {
  max-height: 48px;
}

.blyrics-footer__unison-actions-block:hover {
  & .blyrics-footer__unison-score-line {
    max-height: 20px;
    opacity: 1;
    margin-top: 0;
    pointer-events: auto;
  }
}

.blyrics-footer__container.blyrics-footer__unison-card {
  box-shadow: none;
  outline: 1px solid var(--white-dot-10);
  outline-offset: -1px;
  background: var(--white-dot-10);
  transition: none;

  &:hover {
    background: var(--white-dot-10);
  }
} 

/* ## SECTION-41 - Fullscreen controls ############ */
#blyrics-fs-controls,
.blyrics-fs-info-actions {
  opacity: 1;
  transition: opacity 320ms ease-in-out;
}

#blyrics-fs-controls,
.blyrics-fs-info-actions {
  opacity: 0.7;
  transition: opacity 0.3s ease-in-out;
  &:hover {opacity:1;}
}

.blyrics-fs-disc {
  color: var(--white-1);
  transition: initial;
  opacity: 0.87;
}

.blyrics-fs-disc:hover {
  background: var(--white-dot-10);
  transform: initial;
  outline: 1px solid var(--white-dot-10);
  outline-offset: -1px;
}

.blyrics-fs-disc[data-menu-open] {
  background: var(--white-dot-10);
}

.blyrics-fs-disc:focus,
.blyrics-progress__end:focus,
.blyrics-progress__bar:focus {
  outline: 1px solid var(--white-dot-10);
  outline-offset: -1px;
}

.blyrics-fs-disc:focus-visible,
.blyrics-progress__end:focus-visible {
  outline: 1px solid var(--white-dot-20);
  outline-offset: -1px;
  opacity:1;
}

.blyrics-fs-play {
  background: var(--white-dot-10);
  color: var(--white-1);
  outline: 1px solid var(--white-dot-10);
  outline-offset: -1px;
  &:hover {
  background: var(--white-dot-15);
  outline: 1px solid var(--white-dot-15);
  outline-offset: -1px;
  }
}

.blyrics-fs-disc[data-active] {
  color: var(--white-1);
}

.blyrics-fs-rate-icon {
  width: 70%;
  height: 70%;
}

:is(.blyrics-fs-like, .blyrics-fs-dislike) .blyrics-fs-rate-layer path:nth-child(2) {
  display: none;
}

/* Filled ones */
:is(.blyrics-fs-like, .blyrics-fs-dislike) .blyrics-fs-rate-layer--fill path:first-child {
