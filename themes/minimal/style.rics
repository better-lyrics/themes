/* ## SECTION-1 - Custom Font URLS ################ */
@import url("https://fonts.googleapis.com/css2?family=Roboto+Flex:opsz,wght@8..144,100..1000&display=swap");
@import url('https://fonts.googleapis.com/css2?family=Google+Sans+Flex:opsz,wght@6..144,1..1000&display=swap');

/* ## SECTION-2 - WEBSITE-WIDE FONT SETTINGS ###### */
* {
  --whole-website-font-family:  "Google Sans Flex", "Roboto Flex", Roboto, var(--noto-sans-universal), sans-serif, system-ui;
  /* delete above line to use YTM defaults */
  font-family: var(--whole-website-font-family) !important;
  font-optical-sizing: auto;
  scrollbar-width: thin;
}

/* ## SECTION-3 - EASY CHANGE SETTINGS ############ */

/* -- Karaoke Mode Toggle -- */
$karaoke-mode: off; /* off / minimal / default */

/* - off     = No karaoke - Only Line by line sync    *
 * - minimal = Minimal theme styled lyrics and karaoke*
 *               experience. Better than default.     *
 * - default = The default look and experience of the *
 *               lyrics in BetterLyrics extension     */
 
/* -- Blur toggle -- */
$enable-blur: off; /* on / off */

$blur-amount: 25px;
/* higher number = more blur      *
 * less blur = better performance */
 

  /*# SECTION-3.1 ################################# */

  /* -- Line visibility (opacity) -- */
  .blyrics-container[data-sync="synced"] {
    --current-lyric-visibility: 1;      /* 1    would mean 100%*/
    --previous-lyrics-visibility: 0.6; /* 0.35 would mean 35% */
    --next-lyrics-visibility: 0.15;     /* 0.02 would mean 2%  */
  }
  
  .blyrics-container[data-sync="richsync"] {
    --current-lyric-visibility: 1;      /* 1    would mean 100%*/
    --previous-lyrics-visibility: 1; /* 0.35 would mean 35% */
    --next-lyrics-visibility: 1;     /* 0.02 would mean 2%  */
  }

  .blyrics-container {  
    --hovered-line-visibility: calc(var(--current-lyric-visibility) * 0.8);
    --non-hovered-lines-visibility: calc(var(--current-lyric-visibility) * 0.5);
    --translated-lyric-visibility: 0.82;
    --romanized-lyric-visibility: 0.65;
  }

:root {
  /* -- Colors -- */
  @if $karaoke-mode == off {
  --blyrics-lyric-active-color: var(--white-1);
  --blyrics-lyric-inactive-color: var(--blyrics-lyric-active-color);
  }
  @if $karaoke-mode == minimal {
  --blyrics-lyric-active-color: var(--white-1);
  --blyrics-lyric-inactive-color: oklch(1 0 0 / 0.35);
  }
  @if $karaoke-mode != default {
  --blyrics-ui-text-color: var(--blyrics-lyric-active-color);
  --blyrics-translated-color: var(--white-dot-60);
  --blyrics-error-color: oklch(0.75 0.25 20);
  }

  /* -- Typography -- */
  @if $karaoke-mode != default {
  --blyrics-font-family: var(--whole-website-font-family);
  --blyrics-font-weight: 600;
  --blyrics-font-size: 3.0rem;
  --blyrics-line-height: 1.5;
  --blyrics-padding: 0.45em;
  }
  /* -- Footer -- */
  --blyrics-footer-font-family: var(--whole-website-font-family);
  @if $karaoke-mode != default {
  --blyrics-translated-font-size: 2rem;
  }
  --romanized-font-size: 1.5rem;

  /*# SECTION-3.2 ################################# */

  /* -- Scroll / transition timing -- */
  @if $karaoke-mode != default {
  --lyrics-opacity-duration: 0.4s;
  --lyrics-opacity-transition: opacity var(--lyrics-opacity-duration) var(--blyrics-lyric-scroll-timing-function);
  --blyrics-scale-transition-duration: 0.5s;
  
  /* earliness - negative value delays */
  --richsync-word-earliness: 0.25s;
  --synced-active-line-earliness: 0.6s;

  /* controls earliness/lateness of scrolling lines */
  --richsync-line-scroll-earliness: 0.3s; /* karaoke */
  --synced-line-scroll-earliness: 0.133s;   /* line sync */
  
  /* scroll duration */
  --richsync-all-lines-scroll-uniform-duration: 0.7s;
  --synced-all-lines-scroll-uniform-duration: 0.7s;;
  
  /* scroll timing-function - speed at scroll start and end */
  --richsync-scroll-timing-function: cubic-bezier(0.165, 0.84, 0.44, 1);
  --synced-scroll-timing-function: cubic-bezier(0.215, 0.61, 0.355, 1);
  }
  

  /* -- Highlight fade timing -- */
  @if $karaoke-mode != default {
  --blyrics-lyric-highlight-fade-in-duration: 0.4s;
  --blyrics-lyric-highlight-fade-out-duration: 0.4s;
  }

  /* -- Animation on/off toggles (0 = off, 1 = on) -- */
  @if $karaoke-mode == off {
  --blyrics-animate-highlight-swipe: 0;
  --blyrics-animate-highlight-fade: 0;
  }
  
  @if $karaoke-mode == minimal {
  --blyrics-animate-highlight-swipe: 1;
  --blyrics-animate-highlight-fade: 1;
  }
  
  @if $karaoke-mode != default {
  --blyrics-wobble-duration: 0s;
  --blyrics-animate-line-scale: 0;
  --blyrics-animate-word-wobble: 0;
  --blyrics-animate-highlight-glow: 0;
  --blyrics-animate-instrumental: 0;
  }

  /* -- Scale -- */
  @if $karaoke-mode != default {
  --blyrics-scale: 1;
  }

  /*# SECTION-3.3 Background Effects ############## */
  --blyrics-gradient-stops: none;
  --background-image-transition-duration: 2.5s;
  --background-image-transition-easing: ease-in-out;
  --background-image-transition-delay: 2.5s;
  --background-image-transition: background
    var(--background-image-transition-duration)
    var(--background-image-transition-easing)
    var(--background-image-transition-delay);
  --blyrics-background-saturate: 1; /* removed */
  --background-brightness: 0.217;   /* removed */
  --background-contrast: 0.92;      /* removed */
  
  --brightness-contrast-filter: brightness(var(--background-brightness)) contrast(var(--background-contrast));
  --filter-replacement-backgroundcolor: oklch(15.7861072% 0 0 / 0.80036);

  @if $enable-blur == on {
        --blyrics-background-blur: blur(#{$blur-amount});
  }
  @else {
    --blyrics-background-blur: none;
  }

  /*# SECTION-3.4 Custom Variables ################ */

  /* -- Base palette -- */
  --white-1:      oklch(1 0 0 / 1);
  --white-dot-87: oklch(1 0 0 / 0.87);
  --white-dot-60: oklch(1 0 0 / 0.60);
  --white-dot-30: oklch(1 0 0 / 0.30);
  --white-dot-25: oklch(1 0 0 / 0.25);
  --white-dot-20: oklch(1 0 0 / 0.20);
  --white-dot-15: oklch(1 0 0 / 0.15);
  --white-dot-10: oklch(1 0 0 / 0.10);
  
  --black-1:      oklch(0 0 0 / 1);
  --black-dot-87: oklch(0 0 0 / 0.87);
  --black-dot-60: oklch(0 0 0 / 0.60);
  --black-dot-20: oklch(0 0 0 / 0.20);
  
  --youtube-gray-212121: oklch(0.248 0 0);

  /* -- Easing / curves -- */
  --transition-curve: cubic-bezier(0.27, 1.06, 0.18, 1.00);
  --blyrics-loader-transition-easing: cubic-bezier(0.34, 1.3, 0.64, 1);


  /*# End of SECTION-3.4 ########################## */


  /* Do not delete the following bracket            */
}


/* ## End of SECTION-3 ############################ */



/* ## SECTION-4 - Lyric Animation Fine-tuning ##### */

/* Removing this block will affect lyric animation.
It's supposed to be in a comment like this to work. */

@if $karaoke-mode == off {
/*
;
blyrics-disable-richsync = true;
*/
}

@if $karaoke-mode != default {
/* 
-- why do these features exist -- ;
blyrics-letter-wave = false;
blyrics-add-extra-top-padding = true;
blyrics-target-scroll-pos-ratio = 0.4;
blyrics-passive-scroll-enabled = false;

blyrics-early-scroll-consider-s = 0;

-- Scroll durations (refer Section-3.2) -- ;
blyrics-line-scroll-duration = var(--line-scroll-uniform-duration);
blyrics-line-scroll-above-duration = var(--line-scroll-uniform-duration);
blyrics-line-scroll-below-duration = var(--line-scroll-uniform-duration);
blyrics-line-scroll-active-duration = var(--line-scroll-uniform-duration);
*/
}


/* ## SECTION-5 - Hiding Scrollbar from homepage ## */
html {
  scrollbar-width: none;
}
ytmusic-app-layout > [slot="player-bar"] {
  width: 100dvw;
}

/* ## SECTION-6 - Style and animation of lyrics ### */

  /* ## SECTION-6.1 - Lyrics and wrapper ########## */

@if $karaoke-mode != default {
.blyrics-container[data-sync="richsync"] {
  --blyrics-lyric-scroll-timing-function: var(--richsync-scroll-timing-function);
  --blyrics-scroll-timing-offset: var(--richsync-line-scroll-earliness, 0.5s);
  --all-lines-scroll-uniform-duration:  var(--richsync-all-lines-scroll-uniform-duration);
  --blyrics-richsync-timing-offset: var(--richsync-word-earliness);
}

.blyrics-container[data-sync="synced"] {
  --blyrics-scroll-timing-offset: var(--synced-line-scroll-earliness, 0.5s);
  --all-lines-scroll-uniform-duration:  var(--synced-all-lines-scroll-uniform-duration);
  --blyrics-timing-offset: var(--synced-active-line-earliness);
  --blyrics-lyric-scroll-timing-function: var(--synced-scroll-timing-function);
}
}

@if $karaoke-mode != default {

/* -- 6.1.a Animation & effects disabling -- */

/* Eroding Animations */
@keyframes blyrics-wobble {
  from,
  to {
    transform: none;
  }
}
@keyframes blyrics-glow {
  from,
  to {
    transform: none;
  }
}

/* Hiding the extension's narrow-viewport background glow pseudo-elements */
#blyrics-wrapper .blyrics-container:not([data-no-lyrics="true"])::after,
#blyrics-wrapper .blyrics-container:not([data-no-lyrics="true"])::before {
  display: none;
}

/* karaoke gradient-fill overlay */
@if $karaoke-mode == off {
.blyrics-highlight-run,
.blyrics-word-highlight
{ display: none; }
}

.blyrics-container .blyrics--word {
  transform: none;
  will-change: auto;
}

/* -- 6.1.b Line opacity states (current/prev/next/hover) -- */

/* Container Lines - Base State */
.blyrics-container > div {
  opacity: var(--next-lyrics-visibility);
  transform: none;
  transition: var(--lyrics-opacity-transition);
}

/* Active Line */
@if $karaoke-mode == off {
.blyrics-container > div.blyrics--active {
  opacity: var(--current-lyric-visibility);
}
} @if $karaoke-mode == minimal {
.blyrics-container > div.blyrics--active {
  opacity: var(--current-lyric-visibility);
}
}

/* Next Lines (Lines strictly after the LAST active line) */ /*
#blyrics-wrapper
  .blyrics-container
  > div.blyrics--active
  ~ div:where(:not(.blyrics--active):not(:has(~ .blyrics--active))) {
  opacity: var(--next-lyrics-visibility);
}
*/

/* Next Lines (any line after an active one) */
.blyrics-container
  > div:not(.blyrics--active.blyrics--animating):has([data-word-state="upcoming"]) {
  opacity: var(--next-lyrics-visibility);
}

.blyrics-container
  > div:not(.blyrics--active.blyrics--animating):has([data-word-state="past"]) {
  opacity: var(--previous-lyrics-visibility);
}

/* User Scrolling or Hover */
.blyrics-container:is(:hover, .blyrics-user-scrolling)
  > div:not(.blyrics--active):not(:hover) {
  opacity: var(--non-hovered-lines-visibility);
  transition: opacity 0.3s var(--transition-curve);
}

/* Specific Line Hover */
.blyrics-container:is(:hover, .blyrics-user-scrolling)
  > div:not(.blyrics--active):hover {
  opacity: var(--hovered-line-visibility);
  transition: opacity 0.1s var(--transition-curve);
}

/* Unsynced Lyrics */
.blyrics-container[data-sync="none"] > div {
  opacity: var(--current-lyric-visibility);
  transform: none;
  transition: none;
  margin-top: 0.5em;
  padding-block: 0 !important;
}

/* Final Overrides - higher specificity score */
@if $karaoke-mode == off {
.blyrics-container > .blyrics--active.blyrics--active {
  opacity: var(--current-lyric-visibility);
}
} @if $karaoke-mode == minimal {
.blyrics-container > div.blyrics--animating.blyrics--animating:has([data-word-state="active"]) {
  opacity: var(--current-lyric-visibility);
}
}

/* Previous Lines Enforcer */ /*
#blyrics-wrapper
  .blyrics-container:has(> .blyrics--active):not(.blyrics-user-scrolling):not(
    :hover
  )
  > div:not(.blyrics--active):not(
    :where(.blyrics--active ~ div):not(:has(~ .blyrics--active))
  ) {
  opacity: var(--previous-lyrics-visibility);
}
*/

/* -- 6.1.c Text colors -- */

/* Text Colors */
@if $karaoke-mode == off {
.blyrics-container div .blyrics--word {
  color: var(--white-1);
}
}

/* Translations and Romanization */
.blyrics-container .blyrics--translated {
  color: var(--white-1);
  font-size: var(--blyrics-translated-font-size);
  line-height: 1.5;
  opacity: var(--translated-lyric-visibility);
  transition: var(--lyrics-opacity-transition);
}

@if $karaoke-mode == minimal {
.blyrics-container .blyrics--translated {
  color: var(--blyrics-lyric-inactive-color);
}

.blyrics-container .blyrics--active .blyrics--translated {
  color: var(--blyrics-lyric-active-color);
}
}

.blyrics-container > div.blyrics--active .blyrics--translated {
  opacity: var(--translated-lyric-visibility);
}

.blyrics-container .blyrics--romanized {
  color: var(--white-1);
  font-size: var(--romanized-font-size);
  line-height: 1.5;
  opacity: var(--romanized-lyric-visibility);
  transition: var(--lyrics-opacity-transition);
}

.blyrics-container > div.blyrics--active .blyrics--romanized {
  opacity: var(--romanized-lyric-visibility);
}

/* -- 6.1.d Translation / romanization layout -- */

/* Layout Adjustments for Translations */
.blyrics-container .blyrics--romanized {
  width: auto;
  padding-block: initial;
  background: 0;
  padding: initial;
  border: 0;
  border-radius: 0;
  margin-top: .2em;
  margin-bottom: .2em;
  font-weight: 400;
  letter-spacing: .03em;
}

.blyrics-pip-lyrics .blyrics--romanized {
  padding: initial !important;
  border-radius: 0 !important;
}

.blyrics-container .blyrics--translated {
  margin-top: 0.4em;
  font-weight: 500;
}

/* -- 6.1.e Fullscreen specifics -- */

/* Fullscreen Specifics */
ytmusic-app-layout:not([is-mweb-modernization-enabled])
  [player-fullscreened]:not([blyrics-dfs]) .blyrics-container {
  font-size: calc(var(--blyrics-font-size) * 1.4);
  
  & .blyrics--romanized {
    font-size: calc(var(--romanized-font-size) * 1.4);
  }
  & .blyrics--translated {
    font-size: calc(var(--blyrics-translated-font-size) * 1.4);
  }
}

/* -- 6.1.f Songwriter credits -- */
.blyrics-container > .blyrics-credits {
  font-weight: 400;
  letter-spacing: .03em;
}

} /* end of $karaoke-mode != default for 6.1 */

  /*# SECTION-6.2 - Footer #########################*/

.blyrics-footer__container.blyrics-footer__shaders {
  animation: none;
  background: var(--blyrics-footer-bg-color);
  box-shadow: none;
  border: 1px solid var(--blyrics-footer-border-color);
  padding: 0.5rem 1.25rem;
  font-weight: initial;

  & > span {
    animation: none;
    background: none;
    -webkit-background-clip: initial;
    color: var(--blyrics-footer-link-color);
  }

  &:hover > span {
    text-decoration: underline;
  }
}

div.blyrics-container.blyrics-container > div.blyrics-footer {
  opacity: 1;

  & > * {
    opacity: 0.3;
    transition: opacity 0.1s var(--transition-curve, ease);

    &:hover {
      opacity: 1;
    }
  }
}

/* ## SECTION-7 - Before Lyrics are Loaded ######## */
@keyframes blyrics-shimmer {
  0%   { opacity: 1; }
  100% { opacity: 0.5; }
}

@keyframes blyrics-spin {
  0%, 100% { transform: none; }
}

/* # SECTION-7.1 - Loader styles ################## */
#blyrics-loader::before {
  animation: blyrics-shimmer 1s infinite alternate ease-in-out;
}

#blyrics-loader::after {
  color: var(--blyrics-ui-text-color);
  white-space: pre-wrap;
}

#blyrics-loader:not([state="showing-message"]):not([state="exiting-message"])::after {
  background: initial;
  -webkit-background-clip: initial;
  background-clip: initial;
  color: var(--blyrics-ui-text-color);
  animation: blyrics-shimmer 1s infinite alternate ease-in-out;
  will-change: initial;
}

#blyrics-loader {
  visibility: visible !important;
  transition:
    opacity var(--blyrics-loader-transition-duration, 0.6s) var(--blyrics-loader-transition-easing),
    transform var(--blyrics-loader-transition-duration, 0.6s) var(--blyrics-loader-transition-easing),
    display var(--blyrics-loader-transition-duration, 0.6s) allow-discrete !important;
}

#blyrics-loader[state="hidden"],
#blyrics-loader:not([state]) {
  display: none !important;
  opacity: 0 !important;
  transform: translateY(0) scale(0.85) !important;
}

#blyrics-loader[state="full-loader"],
#blyrics-loader[state="small-loader"],
#blyrics-loader[state="showing-message"],
#blyrics-loader[state="exiting"],
#blyrics-loader[state="exiting-message"] {
  display: flex !important;
}

@starting-style {
  #blyrics-loader[state="full-loader"],
  #blyrics-loader[state="small-loader"],
  #blyrics-loader[state="showing-message"],
  #blyrics-loader[state="exiting"],
  #blyrics-loader[state="exiting-message"] {
    opacity: 0;
    transform: translateY(0) scale(0.85);
  }
}


/* # Section 7.2 - Ad-overlay ########## */
#blyrics-ad-overlay {
  display: none !important;
  opacity: 0;
  animation-play-state: paused;
  transition:
    opacity 0.4s var(--blyrics-loader-transition-easing),
    transform 0.4s var(--blyrics-loader-transition-easing),
    animation-play-state 0.4s allow-discrete
    display 0.4s allow-discrete !important;
}

#blyrics-ad-overlay[active],
:has(ytmusic-player-bar[is-advertisement]) #blyrics-ad-overlay {
  display: flex !important;
  opacity: 1;
}

@starting-style {
  #blyrics-ad-overlay[active],
  :has(ytmusic-player-bar[is-advertisement]) #blyrics-ad-overlay {
    opacity: 0;
    transform: translateY(0) scale(0.85);
  }
}

#blyrics-ad-overlay::before {
  animation: blyrics-shimmer 1s infinite alternate ease-in-out;
}

#blyrics-ad-overlay::after {
  background: none;
  -webkit-background-clip: initial;
  background-clip: initial;
  color: var(--blyrics-ui-text-color);
  white-space: pre-wrap;
  animation: blyrics-shimmer 1s infinite alternate ease-in-out;
  will-change: opacity;
}

#blyrics-wrapper {
  transition:
    transform 0.2s var(--transition-curve),
    opacity 0.2s var(--transition-curve),
    display 0.2s allow-discrete !important;
}

:has(ytmusic-player-bar[is-advertisement]) #blyrics-wrapper,
:has(ytmusic-player-bar[is-advertisement]) #blyrics-loader {
  display: none !important;
  opacity: 0 !important;
  transform: translateY(0) scale(0.85) !important;
}

@starting-style {
  #blyrics-wrapper {
    opacity: 0;
    transform: translateY(0) scale(0.85);
  }
}

/* ## SECTION-8 - Player Background ############### */
ytmusic-player-page::before {
  background-image: var(--blyrics-background-img);
  background-color: var(--filter-replacement-backgroundcolor);
  background-position: 50%;
  background-repeat: no-repeat;
  background-size: cover;
  background-blend-mode: overlay;
  content: "";
  filter: var(--blyrics-background-blur);
  height: 100dvh;
  inset: calc(0px - var(--ytmusic-nav-bar-height)) 0 0
    calc(0px - var(--ytmusic-guide-width));
  position: fixed;
  transition: var(--background-image-transition);
  width: 100dvw;
}
ytmusic-player-page[is-mweb-modernization-enabled]::before {
  inset: 0;
}
ytmusic-player-page[player-fullscreened]::before {
  inset: calc(0px - var(--ytmusic-player-bar-height)) 0 0 0;
}

/* ## SECTION-9 - Album Art Effects ############### */
#player,
#song-media-window,
#song-image,
#thumbnail,
#thumbnail img,
.image.ytmusic-player-bar,
#blyrics-img {
 border-radius: 8% !important;
 corner-shape: superellipse(2);
 box-shadow: none !important;
 overflow: hidden;
}

.image.ytmusic-player-bar {
 outline: 1px solid var(--white-dot-15);
 outline-offset: -1px;
}

#player {
 background: transparent;
}

ytmusic-player {
 &:hover {
  .song-media-controls.ytmusic-player {
   outline: 1px solid var(--white-dot-15);
   outline-offset: -1px;
  }

  #thumbnail img {
   outline: initial;
   outline-offset: -1px;
  }
 }

 #thumbnail img {
  outline: 1px solid var(--white-dot-10);
  outline-offset: -1px;
 }
}

/* ## SECTION-10 - Portrait Window Lyrics Screen ## */
ytmusic-player-page[player-fullscreened] .song-media-controls.ytmusic-player {
  background-image: none !important;
}
.blyrics-container,
.blyrics-container::after,
.blyrics-container::before,
[is-mweb-modernization-enabled][page-type="MUSIC_PAGE_TYPE_TRACK_LYRICS"] {
  background: none !important;
  filter: none !important;
}
ytmusic-player-page[is-mweb-modernization-enabled]
  .background-gradient.ytmusic-player-page,
ytmusic-player-page[is-mweb-modernization-enabled]
  .background-thumbnail.ytmusic-player-page {
    display: none;
}

/* ## SECTION-11 - Portrait Window Lyrics Background*/
ytmusic-player-page[is-mweb-modernization-enabled]
  .background-image.ytmusic-player-page,
ytmusic-player-page[is-mweb-modernization-enabled]
  .side-panel.ytmusic-player-page {
  background: none;
}

ytmusic-player-page[is-mweb-modernization-enabled]
  .background-gradient.ytmusic-player-page,
ytmusic-player-page[is-mweb-modernization-enabled]
  .background-thumbnail.ytmusic-player-page {
  display: none;
}

ytmusic-player-page[is-mweb-modernization-enabled][player-page-ui-state="TABS_VIEW"]
  #side-panel.ytmusic-player-page,
ytmusic-player-page[is-mweb-modernization-enabled][player-page-ui-state="TABS_VIEW"]
  #top-player-bar.ytmusic-player-page {
  backdrop-filter: none;
  background: transparent !important;
  border: 0;
}

#tab-renderer[page-type="MUSIC_PAGE_TYPE_TRACK_LYRICS"],
[is-mweb-modernization-enabled] #player-bar-background.ytmusic-app-layout,
[is-mweb-modernization-enabled] .blyrics-container,
[is-mweb-modernization-enabled][page-type="MUSIC_PAGE_TYPE_TRACK_LYRICS"],
ytmusic-app-layout .ytmusic-app[is-mweb-modernization-enabled] {
  backdrop-filter: none;
  background: none !important;
  filter: none !important;
  border: 0;
}

[is-mweb-modernization-enabled] .blyrics-container::after,
[is-mweb-modernization-enabled] .blyrics-container::before {
  opacity: 0;
}

[is-mweb-modernization-enabled][player-page-open] #guide,
ytmusic-app-layout[is-mweb-modernization-enabled][player-page-open]
  > [slot="nav-bar"] {
  display: none;
}

/* ## SECTION-12 - Player bar background ########## */
ytmusic-player-bar {
  background: transparent !important;

  &:not([player-fullscreened]) {
    backdrop-filter: none !important;
  }
}

#player-bar-background {
  overflow: hidden;
  background-color: transparent;

  &.ytmusic-app-layout {
    background: transparent;
  }
}

ytmusic-app-layout {
  &:not([player-ui-state="FULLSCREEN"]) #player-bar-background {
    backdrop-filter: none !important;
  }

  &[player-ui-state="PLAYER_BAR_ONLY"] #player-bar-background::before {
    content: "";
    position: absolute;
    inset: -90px;
    background-image: var(--blyrics-background-img);
    background-color: var(--filter-replacement-backgroundcolor);
    background-blend-mode: overlay;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    transition: var(--background-image-transition);
    filter: var(--blyrics-background-blur);
    z-index: 0;
  }

  &[player-ui-state="PLAYER_PAGE_OPEN"] #player-bar-background::before {
    content: "";
    position: absolute;
    inset: -90px;
    background-image: var(--blyrics-background-img);
    background-color: var(--filter-replacement-backgroundcolor);
    background-blend-mode: overlay;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    transition: opacity 0.3s ease-in-out 0.3s;
    filter: var(--blyrics-background-blur);
    z-index: 0;
    opacity: 0;
  }

  &:not([player-ui-state="PLAYER_BAR_ONLY"]) #player-bar-background::before {
   /* background: transparent !important; */
  }
}

#layout[player-ui-state="PLAYER_PAGE_OPEN"] #player-bar-background {
  opacity: 1 !important;
}

ytmusic-app #guide-wrapper.ytmusic-app {
  height: calc(100vh - var(--ytmusic-player-bar-height));
}

ytmusic-app-layout[player-fullscreened] > [slot="player-bar"] {
  background: linear-gradient(
    to bottom in oklch,
    oklch(from var(--filter-replacement-backgroundcolor) 0 / 0) 0%,
    oklch(from var(--filter-replacement-backgroundcolor) l c h / 0.002) 2%,
    oklch(from var(--filter-replacement-backgroundcolor) l c h / 0.007) 4%,
    oklch(from var(--filter-replacement-backgroundcolor) l c h / 0.015) 6%,
    oklch(from var(--filter-replacement-backgroundcolor) l c h / 0.026) 8%,
    oklch(from var(--filter-replacement-backgroundcolor) l c h / 0.041) 10%,
    oklch(from var(--filter-replacement-backgroundcolor) l c h / 0.058) 12%,
    oklch(from var(--filter-replacement-backgroundcolor) l c h / 0.078) 14%,
    oklch(from var(--filter-replacement-backgroundcolor) l c h / 0.1) 16%,
    oklch(from var(--filter-replacement-backgroundcolor) l c h / 0.124) 18%,
    oklch(from var(--filter-replacement-backgroundcolor) l c h / 0.151) 20%,
    oklch(from var(--filter-replacement-backgroundcolor) l c h / 0.179) 22%,
    oklch(from var(--filter-replacement-backgroundcolor) l c h / 0.208) 24%,
    oklch(from var(--filter-replacement-backgroundcolor) l c h / 0.238) 26%,
    oklch(from var(--filter-replacement-backgroundcolor) l c h / 0.269) 28%,
    oklch(from var(--filter-replacement-backgroundcolor) l c h / 0.3) 30%,
    oklch(from var(--filter-replacement-backgroundcolor) l c h / 0.331) 32%,
    oklch(from var(--filter-replacement-backgroundcolor) l c h / 0.363) 34%,
    oklch(from var(--filter-replacement-backgroundcolor) l c h / 0.394) 36%,
    oklch(from var(--filter-replacement-backgroundcolor) l c h / 0.424) 38%,
    oklch(from var(--filter-replacement-backgroundcolor) l c h / 0.454) 40%,
    oklch(from var(--filter-replacement-backgroundcolor) l c h / 0.482) 42%,
    oklch(from var(--filter-replacement-backgroundcolor) l c h / 0.51) 44%,
    oklch(from var(--filter-replacement-backgroundcolor) l c h / 0.536) 46%,
    oklch(from var(--filter-replacement-backgroundcolor) l c h / 0.561) 48%,
    oklch(from var(--filter-replacement-backgroundcolor) l c h / 0.584) 50%,
    oklch(from var(--filter-replacement-backgroundcolor) l c h / 0.607) 52%,
    oklch(from var(--filter-replacement-backgroundcolor) l c h / 0.627) 54%,
    oklch(from var(--filter-replacement-backgroundcolor) l c h / 0.646) 56%,
    oklch(from var(--filter-replacement-backgroundcolor) l c h / 0.664) 58%,
    oklch(from var(--filter-replacement-backgroundcolor) l c h / 0.68) 60%,
    oklch(from var(--filter-replacement-backgroundcolor) l c h / 0.695) 62%,
    oklch(from var(--filter-replacement-backgroundcolor) l c h / 0.708) 64%,
    oklch(from var(--filter-replacement-backgroundcolor) l c h / 0.72) 66%,
    oklch(from var(--filter-replacement-backgroundcolor) l c h / 0.731) 68%,
    oklch(from var(--filter-replacement-backgroundcolor) l c h / 0.741) 70%,
    oklch(from var(--filter-replacement-backgroundcolor) l c h / 0.75) 72%,
    oklch(from var(--filter-replacement-backgroundcolor) l c h / 0.757) 74%,
    oklch(from var(--filter-replacement-backgroundcolor) l c h / 0.764) 76%,
    oklch(from var(--filter-replacement-backgroundcolor) l c h / 0.77) 78%,
    oklch(from var(--filter-replacement-backgroundcolor) l c h / 0.775) 80%,
    oklch(from var(--filter-replacement-backgroundcolor) l c h / 0.78) 82%,
    oklch(from var(--filter-replacement-backgroundcolor) l c h / 0.784) 84%,
    oklch(from var(--filter-replacement-backgroundcolor) l c h / 0.787) 86%,
    oklch(from var(--filter-replacement-backgroundcolor) l c h / 0.79) 88%,
    oklch(from var(--filter-replacement-backgroundcolor) l c h / 0.792) 90%,
    oklch(from var(--filter-replacement-backgroundcolor) l c h / 0.795) 92%,
    oklch(from var(--filter-replacement-backgroundcolor) l c h / 0.796) 94%,
    oklch(from var(--filter-replacement-backgroundcolor) l c h / 0.798) 96%,
    oklch(from var(--filter-replacement-backgroundcolor) l c h / 0.799) 98%,
    oklch(from var(--filter-replacement-backgroundcolor) l c h / 0.8) 100%
  ) !important;
}

@media (min-width: 936px) {
  ytmusic-app-layout[player-fullscreened][show-fullscreen-controls]:not([blyrics-dfs], [blyrics-karaoke]) > [slot="player-bar"]:before {
    content: none;
  }
}

/* ## SECTION-13 - Bottom Left Nofication ######### */
tp-yt-paper-toast #close-button {
  display: none !important;
}

#toast {
  background-color: var(--youtube-gray-212121);
  border: 1.5px solid var(--white-dot-10);
  border-radius: 20.88px !important;
  corner-shape: superellipse(2);
}

.yt-spec-button-shape-next--call-to-action-inverse.yt-spec-button-shape-next--text {
  color: oklch(0.63 0.19 257.14);
}

.yt-spec-button-shape-next--call-to-action-inverse.yt-spec-button-shape-next--text:hover {
  background: oklch(0.63 0.19 257.14 / 0.13);
}

yt-notification-action-renderer #toast:not(:hover) {
  animation: idontwannaseeyouanymore-billie 2.5s ease 2.5s forwards !important;
}

yt-notification-action-renderer #toast:hover {
  animation: none !important;
  opacity: 1 !important;
  transform: translateY(0) !important;
  transition:
    opacity 0.3s var(--transition-curve),
    transform 0.3s var(--transition-curve) !important;
}

@keyframes idontwannaseeyouanymore-billie {
  0% {
    opacity: 1;
    transform: translateY(0);
    animation-timing-function: ease-in;
  }
  87% {
    opacity: 0.6;
    transform: translateY(0);
    pointer-events: auto;
    animation-timing-function: ease;
  }
  99% {
    opacity: 0;
    transform: translateY(100px);
    pointer-events: auto;
  }
  100% {
    opacity: 0;
    transform: translateY(100px);
    pointer-events: none;
    visibility: hidden;
  }
}

#text.yt-notification-action-renderer, #sub-text.yt-notification-action-renderer {
    color: var(--white-1);
    opacity: 0.87;
}

/* ## SECTION-14 - Volume popup ################### */
ytmusic-player-expanding-menu {
  border-radius: 13.92px;
  corner-shape: superellipse(2);
  max-height: 60px;
}

#main-panel.ytmusic-player-page {
  height: auto;
}

/* ## SECTION-15 - Space above album art ########## */
.strapline.ytmusic-responsive-header-renderer {
  margin-top: 0;
}

/* ## SECTION-16 - Background of Albums etc. ###### */
ytmusic-fullbleed-thumbnail-renderer {
  display: block !important;
  position: fixed !important;
  top: 0 !important;
  left: 0 !important;
  width: 100dvw !important;
  height: 100dvh !important;
  max-width: none !important;
  max-height: none !important;
  z-index: 0;
}

ytmusic-app-layout.content-scrolled #mini-guide-background.ytmusic-app-layout {
  opacity: 0;
}

#nav-bar-background.ytmusic-app-layout {
  transition: opacity 0.4s ease-in-out;
}

#layout[player-ui-state="PLAYER_PAGE_OPEN"] #nav-bar-background {
  transition: opacity 0.8s ease-in-out 0.2s;
}

#background > ytmusic-fullbleed-thumbnail-renderer > picture::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: var(--filter-replacement-backgroundcolor);
  pointer-events: none;
  backdrop-filter: var(--blyrics-background-blur);
}

ytmusic-browse-response[has-background][page-type="MUSIC_PAGE_TYPE_NON_MUSIC_AUDIO_TRACK_PAGE"]
  .immersive-background.ytmusic-browse-response
  ytmusic-fullbleed-thumbnail-renderer.ytmusic-browse-response,
ytmusic-browse-response[has-background][page-type="MUSIC_PAGE_TYPE_PODCAST_SHOW_DETAIL_PAGE"]
  .immersive-background.ytmusic-browse-response
  ytmusic-fullbleed-thumbnail-renderer.ytmusic-browse-response,
ytmusic-browse-response[has-background][is-playlist-detail-page]
  .immersive-background.ytmusic-browse-response
  ytmusic-fullbleed-thumbnail-renderer.ytmusic-browse-response,
ytmusic-browse-response[has-background][is-album-detail-page]
  .immersive-background.ytmusic-browse-response
  ytmusic-fullbleed-thumbnail-renderer.ytmusic-browse-response {
  filter: none;
}

ytmusic-browse-response[has-background]:not([disable-gradient])
  .background-gradient.ytmusic-browse-response {
  background-image: none;
}

.image.ytmusic-immersive-header-renderer
  ~ .content-container-wrapper.ytmusic-immersive-header-renderer
  .gradient-container.ytmusic-immersive-header-renderer {
  background: none;
}

.image.ytmusic-immersive-header-renderer
  ~ .content-container-wrapper.ytmusic-immersive-header-renderer {
  background: none;
}

/* ## SECTION-17 - Search Box ##################### */

ytmusic-search-box[has-query], ytmusic-search-box[opened] {
  border: none;
}

ytmusic-search-box {
  & {
    --ytmusic-search-border: var(--white-dot-10);
    --ytmusic-search-background: var(--youtube-gray-212121);

    & .search-box.ytmusic-search-box {
      transition: background-color 0.2s var(--transition-curve);
    }

    & #suggestion-list {
      transition-duration: 0.1s;
      transition-property: opacity;
      transition-timing-function: var(--transition-curve);

      &.ytmusic-search-box {
        border-radius: 0 0 20px 20px;
        corner-shape: superellipse(2);
      }
    }

    &:not([opened]) {
      & .search-container.ytmusic-search-box {
        border-radius: 20px;
        corner-shape: superellipse(2);
      }

      & #suggestion-list {
        opacity: 0;
      }

      &:not([has-query]) {
        opacity: 0.7;
        transition: opacity 0.2s var(--transition-curve);

        &:hover {
          opacity: 1;
        }

        & .search-box.ytmusic-search-box {
          background: var(--white-dot-10);
          border-radius: 20px;
          corner-shape: superellipse(2);
        }
      }
    }

    &[has-query] .search-container.ytmusic-search-box {
      box-shadow: none;
    }

    &[opened]:not(:has(ytmusic-search-suggestions-section)) {
      & #suggestion-list {
        opacity: 0;
      }

      & .search-box.ytmusic-search-box {
        border-radius: 20px;
        corner-shape: superellipse(2);
      }
    }

    &[opened]:has(ytmusic-search-suggestions-section) .search-box.ytmusic-search-box {
      border-radius: 20px 20px 0 0;
      corner-shape: superellipse(2);
    }
  }

  &[opened] .search-container.ytmusic-search-box {
    box-shadow: none;
  }
}

ytmusic-search-suggestion {
  color: var(--white-dot-87);
}

#suggestions.ytmusic-search-suggestions-section
  > .ytmusic-search-suggestions-section {
  border-radius: 20px;
  corner-shape: superellipse(2);
  
  &:is(.hover, .selected-suggestion, :hover) {
    background-color: var(--white-dot-10);
    /*box-shadow: inset 0 0 0px 1px var(--white-dot-10);*/
    outline: 1px solid var(--white-dot-10);
    outline-offset: -1px;
    border-radius: 20px;
    corner-shape: superellipse(2);
  }
}

/* ## SECTION-18 - 3button menu design ############ */
ytmusic-menu-popup-renderer {
  display: flex;
  flex-direction: column;
  overflow: hidden !important;
}

tp-yt-paper-listbox.ytmusic-menu-popup-renderer {
  width: auto;
  padding: 1.2em 0;
  border-radius: 13.92px;
  corner-shape: superellipse(2);
}

tp-yt-paper-listbox#items {
  flex: 1 1 auto;
  overflow-y: auto;
  scroll-behavior: smooth;
}

ytmusic-popup-container tp-yt-iron-dropdown {
  width: auto !important;
  height: auto !important;
  max-width: none !important;
  background: transparent !important;
  box-shadow: none !important;
  pointer-events: none !important;
}

ytmusic-popup-container #contentWrapper {
  display: flex !important;
  flex-direction: column !important;
  justify-content: flex-start !important;
  width: max-content !important;
  max-height: 65dvh !important;
  pointer-events: auto !important;
}

#items.ytmusic-menu-popup-renderer > .ytmusic-menu-popup-renderer {
  border-radius: 13.92px;
  corner-shape: superellipse(2);
  
  &:hover {
    background-color: var(--white-dot-10);
    /*box-shadow: inset 0 0 0px 1px var(--white-dot-10);*/
    outline: 1px solid var(--white-dot-10);
    outline-offset: -1px;
    border-radius: 13.92px;
    corner-shape: superellipse(2);
   }
}

/* ## SECTION-19 - Player Queue Header ############ */
ytmusic-queue-header-renderer {
  box-sizing: border-box;
  border-radius: 15px;
  corner-shape: superellipse(1);
  align-items: flex-start;
  padding: calc(3%);
  margin: 0 0 calc(3%);
  position: sticky;
  top: calc(2%);
  z-index: 1000;
  container-type: inline-size;
  border: none;
  box-shadow: 0px 4px 10px 0px var(--black-dot-20);

  &::before {
    content: "";
    overflow: hidden;
    position: absolute;
    background-image: var(--blyrics-background-img);
    background-color: var(--filter-replacement-backgroundcolor);
    background-blend-mode: overlay;
    background-position: 50%;
    background-repeat: no-repeat;
    background-size: cover;
    transition: var(--background-image-transition);
    filter: var(--blyrics-background-blur);
    z-index: -1;
    inset: 0;
    border: none;
    border-radius: inherit;
    corner-shape: inherit;
    opacity: 1;
  }

  &::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    corner-shape: inherit;
    border: none;
    /*box-shadow: inset 0 0 0px 1px white;*/
    outline: 1px solid var(--white-1);
    outline-offset: -1px;
    opacity: 0.1;
    z-index: -1;
    pointer-events: none;
  }

  .container-name {
    & .subtitle,
    & .title {
      color: var(--white-dot-87);
    }

    & .title {
      font-weight: 100;
    }
  }
}

ytmusic-chip-cloud-chip-renderer[chip-style="STYLE_TRANSPARENT"] {
  & a.ytmusic-chip-cloud-chip-renderer {
    border-radius: calc(15px + 3%);
    corner-shape: superellipse(2);
    background: var(--white-dot-60);
    padding: 6px;
    color: var(--black-dot-87);

    yt-icon {
      color: inherit;
    }

    &:hover {
      background-color: var(--white-dot-87);
    }
  }
}

#buttons > ytmusic-chip-cloud-chip-renderer > div > a > yt-icon {
  margin-left: 5px;
}

#tab-renderer {
  &[page-type="MUSIC_PAGE_TYPE_TRACK_RELATED"] {
    -webkit-mask-image: linear-gradient(to bottom in oklch, oklch(none none none / 0) 0%, var(--black-1) 8%);
    mask-image: linear-gradient(to bottom in oklch, oklch(none none none / 0) 0%, var(--black-1) 8%);  
  }

  &[page-type="MUSIC_PAGE_TYPE_TRACK_LYRICS"] {
    scrollbar-color: transparent transparent;
    -webkit-mask-image: linear-gradient(to bottom in oklch, oklch(none none none / 0),var(--black-1) 50px,var(--black-1) calc(100% - 50px),transparent);
    mask-image: linear-gradient(to bottom in oklch, oklch(none none none / 0),var(--black-1) 50px,var(--black-1) calc(100% - 50px),transparent);
  }

  &:not([page-type="MUSIC_PAGE_TYPE_TRACK_RELATED"]):not(
      [page-type="MUSIC_PAGE_TYPE_TRACK_LYRICS"]
    ) {
    margin-top: 0;
  }
  
  -webkit-mask-image: linear-gradient(to bottom in oklch, oklch(none none none / 0) 0%, var(--black-1) 9%);
  mask-image: linear-gradient(to bottom in oklch, oklch(none none none / 0) 0%, var(--black-1) 9%);
  mask-attachment: scroll;
  -webkit-mask-attachment: scroll;
}

/* ## SECTION-20 - Player Queue ################### */
ytmusic-player-queue-item[play-button-state="loading"],
ytmusic-player-queue-item[play-button-state="paused"],
ytmusic-player-queue-item[play-button-state="playing"] {
  border-radius: 13.92px;
  corner-shape: superellipse(2);
}

/* ## SECTION-21 - Player Queue Items ############# */
ytmusic-player-queue-item {
  border: none;
  border-radius: 13.92px;
  corner-shape: superellipse(2);
}

#contents ytmusic-player-queue-item {
&:hover {
    background: var(--white-dot-10);
    /*box-shadow: inset 0 0 0px 1px var(--white-dot-15);*/
    outline: 1px solid var(--white-dot-15);
    outline-offset: -1px;
  }
}

/* ## SECTION-22 - Player Queue- dragging item #### */
ytmusic-player-queue-item:is(
    [style*="z-index: 9"],
    [style*="cursor: move"]
  ):hover {
  border-radius: 13.92px !important;
  corner-shape: superellipse(2);
  background: var(--youtube-gray-212121) !important;
  box-sizing: border-box !important;
  height: var(--ytmusic-list-item-height, 56px) !important;
  width: auto !important;
  margin: 0 !important;
}
ytmusic-playlist-panel-video-wrapper-renderer:is(
    [style*="z-index: 9"],
    [style*="cursor: move"]
  ) {
  box-sizing: border-box !important;
  height: var(--ytmusic-list-item-height, 56px) !important;
  width: auto !important;
  margin: 0 !important;
  background: var(--youtube-gray-212121) !important;
  border-radius: 13.92px;
  corner-shape: superellipse(2);
  display: flex !important;
  align-items: center;
  padding: 0 8px;
}
ytmusic-playlist-panel-video-wrapper-renderer:is(
    [style*="z-index: 9"],
    [style*="cursor: move"]
  ):hover {
  box-sizing: border-box !important;
  height: var(--ytmusic-list-item-height, 56px) !important;
  width: auto !important;
  margin: 0 !important;
  background: var(--youtube-gray-212121) !important;
  border-radius: 13.92px;
  corner-shape: superellipse(2);
  display: flex !important;
  align-items: center;
  padding: 0 8px;
}

/* ## SECTION-23 - Arist Page background ########## */
ytmusic-browse-response:has([main-page-type="MUSIC_PAGE_TYPE_ARTIST"])
  .image.ytmusic-fullbleed-thumbnail-renderer {
  filter: none !important;
  opacity: 1 !important;
}
ytmusic-browse-response:has([main-page-type="MUSIC_PAGE_TYPE_ARTIST"])
  ytmusic-fullbleed-thumbnail-renderer::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 200dvh;
  --fade-height: calc(
    var(--ytmusic-immersive-header-padding-top) +
      var(--ytmusic-immersive-header-gradient-padding-top)
  );
  --mask-gradient: linear-gradient(
  to bottom in oklch,
  oklch(0 0 0 / 0.000) 0dvh,
  oklch(0 0 0 / 0.009) calc(var(--fade-height) * 1 / 6),
  oklch(0 0 0 / 0.040) calc(var(--fade-height) * 2 / 6),
  oklch(0 0 0 / 0.098) calc(var(--fade-height) * 3 / 6),
  oklch(0 0 0 / 0.184) calc(var(--fade-height) * 4 / 6),
  oklch(0 0 0 / 0.301) calc(var(--fade-height) * 5 / 6),
  oklch(0 0 0 / 0.450) calc(var(--fade-height) * 6 / 6),
  oklch(0 0 0 / 0.590) calc(var(--fade-height) * 7 / 6),
  oklch(0 0 0 / 0.708) calc(var(--fade-height) * 8 / 6),
  oklch(0 0 0 / 0.804) calc(var(--fade-height) * 9 / 6),
  oklch(0 0 0 / 0.880) calc(var(--fade-height) * 10 / 6),
  oklch(0 0 0 / 0.936) calc(var(--fade-height) * 11 / 6),
  oklch(0 0 0 / 0.974) calc(var(--fade-height) * 12 / 6),
  oklch(0 0 0 / 0.994) calc(var(--fade-height) * 13 / 6),
  oklch(0 0 0 / 1.000) calc(var(--fade-height) * 14 / 6)
);
  -webkit-mask-image: var(--mask-gradient);
  mask-image: var(--mask-gradient);
  background-color: var(--filter-replacement-backgroundcolor);
  backdrop-filter: var(--blyrics-background-blur);
  z-index: 1;
  pointer-events: none;
  animation: slide-dimmer-up linear both;
  animation-timeline: scroll(root);
  animation-range: 0 50dvh;
}
@keyframes slide-dimmer-up {
  0% {
    transform: translateY(0);
  }
  to {
    transform: translateY(-100dvh);
  }
}
ytmusic-immersive-header-renderer {
  --ytmusic-immersive-header-padding-top: 48dvh;
  --ytmusic-immersive-header-gradient-padding-top: 12dvh;
}

/* ## SECTION-23.1 - Portrait Window Specifics #### */
[is-mweb-modernization-enabled] ytmusic-immersive-header-renderer {
  --ytmusic-immersive-header-padding-top: 28dvh;
  --ytmusic-immersive-header-gradient-padding-top: 12dvh;
}

@property --fade-stop {
  syntax: '<percentage>';
  inherits: false;
  initial-value: 65%;
}

[is-mweb-modernization-enabled]
  ytmusic-browse-response:has([main-page-type="MUSIC_PAGE_TYPE_ARTIST"])
  .image.ytmusic-fullbleed-thumbnail-renderer.ytmusic-fullbleed-thumbnail-renderer {
  position: fixed !important;
  top: 0;
  left: 0;
  z-index: 0;
  width: 100dvw;
  height: 45dvh;
  object-fit: cover;
  --fade-stop: 65%;
  mask-image: linear-gradient(
    to bottom in oklch,
    var(--black-1) var(--fade-stop),
    calc(var(--fade-stop) + (100% - var(--fade-stop)) * 0.65),
    oklch(none none none / 0) 100%
  );
  -webkit-mask-image: linear-gradient(
    to bottom in oklch,
    var(--black-1) var(--fade-stop),
    calc(var(--fade-stop) + (100% - var(--fade-stop)) * 0.65),
    oklch(none none none / 0) 100%
  );
  animation-name: expand-dim-stick;
  animation-timeline: scroll(root);
  animation-range: 0dvh 70dvh;
  animation-fill-mode: both;
  animation-timing-function: ease-out;
}

[is-mweb-modernization-enabled]
  ytmusic-browse-response:has([main-page-type="MUSIC_PAGE_TYPE_ARTIST"])
  .image.ytmusic-fullbleed-thumbnail-renderer
  img,
[is-mweb-modernization-enabled]
  ytmusic-browse-response:has([main-page-type="MUSIC_PAGE_TYPE_ARTIST"])
  .image.ytmusic-fullbleed-thumbnail-renderer
  picture {
  width: 100dvw !important;
  height: 100dvh !important;
  object-fit: cover !important;
}

@keyframes expand-dim-stick {
  90% {
    height: 100dvh;
    --fade-stop: 90%;
  }

  to {
    height: 100dvh;
    --fade-stop: 100%;
  }
}

@media (prefers-reduced-motion: reduce) {
  ytmusic-browse-response:has([main-page-type="MUSIC_PAGE_TYPE_ARTIST"])
    ytmusic-fullbleed-thumbnail-renderer::before {
    animation: none;
    transform: translateY(-100dvh);
  }

  [is-mweb-modernization-enabled]
    ytmusic-browse-response:has([main-page-type="MUSIC_PAGE_TYPE_ARTIST"])
    .image.ytmusic-fullbleed-thumbnail-renderer.ytmusic-fullbleed-thumbnail-renderer {
    animation: none;
    height: 100dvh;
    --fade-stop: 100%;
  }
}

/* ## SECTION-24 - Fullscreen No Lyrics animation #*/
ytmusic-player-page[player-fullscreened]:not([blyrics-video-mode]):not(
    [blyrics-dfs],
    [blyrics-karaoke]
  )[blyrics-no-lyrics]
  #main-panel {
  transition: transform 1.5s ease-in-out !important;
  transition-delay: var(--blyrics-no-lyrics-slide-delay) !important;
}

ytmusic-player-page[player-fullscreened][blyrics-video-mode]:not(
    [blyrics-dfs],
    [blyrics-karaoke]
  )[blyrics-no-lyrics]
  #main-panel {
  transition: transform 1.5s ease-in-out !important;
  transition-delay: var(--blyrics-no-lyrics-slide-delay) !important;
}

ytmusic-player-page[player-fullscreened]:not([blyrics-video-mode]):not(
    [blyrics-dfs],
    [blyrics-karaoke]
  )[blyrics-no-lyrics]
  #player {
  transition: max-width 2.5s ease-in-out !important;
  transition-delay: var(--blyrics-no-lyrics-slide-delay) !important;
}

ytmusic-player-page[player-fullscreened]:not([blyrics-dfs], [blyrics-karaoke])[blyrics-no-lyrics]
  #blyrics-wrapper {
  transition: opacity 1.5s ease !important;
  transition-delay: var(--blyrics-no-lyrics-slide-delay) !important;
}

/* ## SECTION-25 - Music Note Animation disable ### */
@if $karaoke-mode != default {
.blyrics--instrumental-icon {
  display: none;
}
.blyrics--instrumental.blyrics--line::after {
  content: "♫";
  display: inline-block;
  font-size: 1.2em;
  animation: none;
  animation-play-state: paused;
  transform: scale(100%);
  text-shadow: unset;
  filter:none;
  opacity: 1;
}
.blyrics--active.blyrics--animating.blyrics--instrumental.blyrics--line::after {
  animation: note-pulse 1.5s ease-in-out infinite;
  animation-play-state: running;
}
.blyrics--paused.blyrics--active.blyrics--animating.blyrics--instrumental.blyrics--line::after,
.blyrics-container:is(:hover, .blyrics-user-scrolling) .blyrics--instrumental.blyrics--line::after {
  animation-play-state: paused;
}

/* empty lines */
.blyrics--line:has(.blyrics-bidi-run:empty) .blyrics-line-main {
  display: inline-flex;
  align-items: center;
  min-height: 1.5em;
  line-height: var(--blyrics-line-height);
}

.blyrics--line:has(.blyrics-bidi-run:empty) .blyrics-line-main::before {
  content: "♫";
}

.blyrics--active.blyrics--animating.blyrics--line:has(.blyrics-bidi-run:empty) .blyrics-line-main::before {
  animation: note-pulse 1.5s ease-in-out infinite;
  animation-play-state: running;
}

.blyrics--paused.blyrics--line:has(.blyrics-bidi-run:empty) .blyrics-line-main::before {
  animation-play-state: paused;
}

@keyframes note-pulse {
  0% {
    text-shadow: 0px 0 2px transparent;
    opacity: 0.6;
    transform: scale(100%);
    transform-origin: bottom center;
  }
  50% {
    text-shadow: 0px 0px 8px var(--white-dot-60);
    opacity: 1;
    transform: scale(105%);
    transform-origin: bottom center;
  }
  100% {
    text-shadow: 0px 0 2px transparent;
    opacity: 0.6;
    transform: scale(100%);
    transform-origin: bottom center;
  }
}
} /* end of $karaoke-mode != default wrapper for Section-25 */

@if $karaoke-mode == minimal {
.blyrics--instrumental.blyrics--line::after,
.blyrics--line:has(.blyrics-bidi-run:empty) .blyrics-line-main::before {
  color: var(--blyrics-lyric-inactive-color);
}
.blyrics--active.blyrics--animating.blyrics--instrumental.blyrics--line::after,
.blyrics--active.blyrics--animating.blyrics--line:has(.blyrics-bidi-run:empty) .blyrics-line-main::before {
  color: var(--blyrics-lyric-active-color);
}
}

/* ## SECTION-26 - Portrait View Player Fix ####### */
ytmusic-player#player,
ytmusic-player-bar,
#top-player-bar {
  view-transition-name: none !important;
}

@keyframes open-player-page {
  0% {
    transform: translate3d(0, 100vh, 0);
    opacity: 1;
  }
  100% {
    transform: translate3d(0, 0, 0);
    opacity: 1;
  }
}

@keyframes collapse-player-page {
  0% {
    transform: translate3d(0, 0, 0);
    opacity: 1;
  }
  99% {
    transform: translate3d(0, 100vh, 0);
    opacity: 1;
  }
  100% {
    transform: translate3d(0, 100vh, 0);
    opacity: 0;
  }
}

ytmusic-app-layout[player-page-open] > [slot="player-page"] {
  animation: open-player-page 0.4s ease-in-out !important;
}

ytmusic-app-layout[player-ui-state="PLAYER_BAR_ONLY"] > [slot="player-page"] {
  animation: collapse-player-page 0.4s ease-in-out !important;
}

ytmusic-player-page[player-ui-state="PLAYER_BAR_ONLY"] ytmusic-player#player {
  transition-property:
    position, bottom, block-size, height, inline-size, width, left, margin,
    right, top, border-radius, transform, max-width !important;
  transition-behavior: allow-discrete !important;
  transition-delay: 0.4s !important;
  transition-duration: 0.0013s !important;
  transition-timing-function: step-end !important;
}

ytmusic-player-page[player-ui-state="PLAYER_BAR_ONLY"]
  ytmusic-player#player
  .song-media-controls.ytmusic-player {
  transition-property: display, opacity, visibility !important;
  transition-behavior: allow-discrete !important;
  transition-delay: 0.4s !important;
  transition-duration: 0.0013s !important;
  transition-timing-function: step-end !important;
}

ytmusic-player-page[player-ui-state="PLAYER_BAR_ONLY"]
  #top-player-bar.ytmusic-player-page {
  opacity: 0 !important;
  visibility: hidden !important;
  transition: none !important;
}

ytmusic-player-page[player-ui-state="PLAYER_BAR_ONLY"]
  tp-yt-paper-tabs.ytmusic-player-page {
  visibility: hidden !important;
  transition-behavior: allow-discrete !important;
  transition: visibility 0.4s step-end !important;
}

#layout
  ytmusic-player-page[is-mweb-modernization-enabled][player-page-ui-state="FULL_PLAYER_VIEW"]
  #info-panel.ytmusic-player-page,
#layout
  ytmusic-player-page[is-mweb-modernization-enabled][player-page-ui-state="FULL_PLAYER_VIEW"]
  #player-controls.ytmusic-player-page,
#layout
  ytmusic-player-page[is-mweb-modernization-enabled][player-page-ui-state="FULL_PLAYER_VIEW"]
  .av.ytmusic-player-page,
#layout
  ytmusic-player-page[is-mweb-modernization-enabled][player-page-ui-state="FULL_PLAYER_VIEW"]
  .collapse-button.ytmusic-player-page,
#layout
  ytmusic-player-page[is-mweb-modernization-enabled][player-page-ui-state="FULL_PLAYER_VIEW"]
  .context-menu-button.ytmusic-player-page {
  opacity: 1;
  visibility: visible;
  transform: none;
  transition:
    opacity 0.2667s ease-in-out 0.2667s,
    transform 0.4s ease-in-out,
    visibility 0s ease-in-out !important;
}

#layout
  ytmusic-player-page[is-mweb-modernization-enabled][player-page-ui-state="TABS_VIEW"]
  #info-panel.ytmusic-player-page,
#layout
  ytmusic-player-page[is-mweb-modernization-enabled][player-page-ui-state="TABS_VIEW"]
  #player-controls.ytmusic-player-page,
#layout
  ytmusic-player-page[is-mweb-modernization-enabled][player-page-ui-state="TABS_VIEW"]
  .av.ytmusic-player-page,
#layout
  ytmusic-player-page[is-mweb-modernization-enabled][player-page-ui-state="TABS_VIEW"]
  .collapse-button.ytmusic-player-page,
#layout
  ytmusic-player-page[is-mweb-modernization-enabled][player-page-ui-state="TABS_VIEW"]
  .context-menu-button.ytmusic-player-page {
  opacity: 0 !important;
  visibility: hidden !important;
  transform: translate3d(0, -285%, 0);
  transition:
    opacity 0.1067s ease-in-out,
    transform 0.4s ease-in-out,
    visibility 0.4s ease-in-out !important;
}

#layout
  ytmusic-player-page[is-mweb-modernization-enabled][player-ui-state="PLAYER_BAR_ONLY"]
  #info-panel.ytmusic-player-page,
#layout
  ytmusic-player-page[is-mweb-modernization-enabled][player-ui-state="PLAYER_BAR_ONLY"]
  #player-controls.ytmusic-player-page,
#layout
  ytmusic-player-page[is-mweb-modernization-enabled][player-ui-state="PLAYER_BAR_ONLY"]
  .av.ytmusic-player-page,
#layout
  ytmusic-player-page[is-mweb-modernization-enabled][player-ui-state="PLAYER_BAR_ONLY"]
  .collapse-button.ytmusic-player-page,
#layout
  ytmusic-player-page[is-mweb-modernization-enabled][player-ui-state="PLAYER_BAR_ONLY"]
  .context-menu-button.ytmusic-player-page {
  opacity: 0 !important;
  visibility: hidden !important;
  transition:
    opacity 0.0667s ease-in-out 0.3333s,
    visibility 0.0667s ease-in-out 0.3333s !important;
}

::view-transition-group(player-bar),
::view-transition-old(player-bar),
#top-player-bar {
  transition-duration: 0.4s !important;
  transition-timing-function: ease-in-out !important;
}

#player,
#side-panel,
#main-panel {
  transition-property: transform !important;
  transition-duration: 0.4s !important;
  transition-timing-function: ease-in-out !important;
}

/* ## SECTION-27 - Tab headings animation change ## */
tp-yt-paper-ripple,
#selectionBar {
  display: none !important;
}

tp-yt-paper-tab {
  text-transform: uppercase;
  color: var(--white-1);
  opacity: 0.7;
  transition: none;

  &:hover {
    opacity: 1;
  }
}

tp-yt-paper-tab .tab-content {
  border-radius: 999rem;
  corner-shape: superellipse(1.2);
  transition: none;
}

[is-mweb-modernization-enabled] tp-yt-paper-tab .tab-content:hover,
tp-yt-paper-tab:not(.iron-selected) .tab-content:hover {
  color: var(--white-1);
  background-color: var(--white-dot-10);
  /*box-shadow: inset 0 0 0px 1px var(--white-dot-10);*/
  outline: 1px solid var(--white-dot-10);
  outline-offset: -1px;
}

[is-mweb-modernization-enabled][player-ui-state="MINIPLAYER_IN_PLAYER_PAGE"]
  tp-yt-paper-tab.iron-selected,
:not([is-mweb-modernization-enabled])[player-ui-state="PLAYER_PAGE_OPEN"]
  tp-yt-paper-tab.iron-selected {
  color: var(--white-1);
  opacity: 0.87;
  transition: none;

  &:hover {
    opacity: 1;
  }

  & .tab-content {
    background-color: var(--white-dot-10);
    /*box-shadow: inset 0 0 0px 1px var(--white-dot-10);*/
    outline: 1px solid var(--white-dot-10);
    outline-offset: -1px;
  }

  & .tab-content:hover {
    background-color: var(--white-dot-15);
    /*box-shadow: inset 0 0 0px 1px var(--white-dot-15);*/
    outline: 1px solid var(--white-dot-15);
    outline-offset: -1px;
  }
}

[is-mweb-modernization-enabled][player-ui-state="PLAYER_PAGE_OPEN"]
  tp-yt-paper-tab.iron-selected.ytmusic-player-page,
[is-mweb-modernization-enabled][player-ui-state="PLAYER_PAGE_OPEN"]
tp-yt-paper-tab:not(.iron-selected) .tp-yt-paper-tab[style-target=tab-content] {
  color: var(--white-1);
}

[player-ui-state="MINIPLAYER_IN_PLAYER_PAGE"]
  tp-yt-paper-tab.iron-selected
  .tab-content:hover {
  color: inherit;
  background: transparent;
  box-shadow: none;
}

.tp-yt-paper-tab[style-target=tab-content], tp-yt-paper-tab .tp-yt-paper-tab[style-target=tab-content] {
  transition: none;
}

ytmusic-player-page[is-mweb-modernization-enabled][player-page-ui-state="TABS_VIEW"]
  tp-yt-paper-tabs.ytmusic-player-page {
  border-bottom: none;
  margin-top: 15px;
}

ytmusic-player-page tp-yt-paper-tabs.ytmusic-player-page {
  border-bottom: none;
}

/* ### Section 28 - Portrait Window No Lyrics ##### */
ytmusic-player-page[is-mweb-modernization-enabled]
  #blyrics-wrapper
  > div.blyrics-no-lyrics-button-container {
  margin: 4rem;
}

ytmusic-player-page[is-mweb-modernization-enabled]
  #blyrics-wrapper
  > div.blyrics-container[data-no-lyrics="true"]
  #blyrics-spacing-element {
  display: none !important;
}

/* ### Section 29 - No Lyrics Text Replace ######## */
@keyframes fadeOutOnly {
  from { opacity: 1; }
  to { opacity: 0; }
}

@keyframes fadeInOnly {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes noteFadeIn {
  from { opacity: 0; }
  to { opacity: .45; }
}

@keyframes go-invisible {
  to {
    visibility: hidden;
    pointer-events: none;
  }
}

.blyrics-container[data-no-lyrics="true"] .blyrics-line-main {
  position: relative;
  min-height: 1lh;
}

.blyrics-container[data-no-lyrics="true"] .blyrics-line-main > .blyrics-bidi-run {
  animation:
    fadeOutOnly 2s forwards 8s,
    go-invisible 0s forwards 10s;
}

.blyrics-container[data-no-lyrics="true"]:hover .blyrics-line-main > .blyrics-bidi-run {
  opacity: 0 !important;
  visibility: hidden !important;
}

.blyrics-container[data-no-lyrics="true"]::before {
  content: "No lyrics found";
  position: absolute;
  inset: 0;
  display: flex;
  justify-content: center;
  align-items: center;
  opacity: 0;
  pointer-events: none;
}

.blyrics-container[data-no-lyrics="true"]:hover::before {
  opacity: 1;
}

.blyrics-container[data-no-lyrics="true"]:hover::after {
  opacity: 0 !important;
}

.blyrics-container[data-no-lyrics="true"] {
  padding-top: 4em;
  padding-bottom: 4em !important;
}

.blyrics-no-lyrics-button-container {
 flex-wrap: wrap;
}

/* this is from the portrait mode gradient and filter */
.blyrics-container[data-no-lyrics="true"]::before,
.blyrics-container[data-no-lyrics="true"]::after {
  background: none !important;
  filter: none !important;
  border-radius: 0;
}

.blyrics-container[data-no-lyrics="true"]::after {
  content: "♫";
  position: absolute;
  inset: 0;
  display: flex;
  justify-content: center;
  align-items: center;
  opacity: 0;
  cursor: help;
  font-size: 1.4em;
  scale: 1;
  animation:
    noteFadeIn 2s forwards 10.2s,
    i-love-a-shooting-star 6s linear infinite 12.2s;

    /* test */
  --energy-color: #FFFCF0;
  
    /* test */
}

@keyframes i-love-a-shooting-star {
  0% {
    opacity: .45;
    scale: 1;
    text-shadow:
      0 0 5px oklch(from var(--energy-color) l c h / 0%),
      0 0 5px oklch(from var(--energy-color) l c h / 0%),
      0 0 5px oklch(from var(--energy-color) l c h / 0%),
      0 0 5px oklch(from var(--energy-color) l c h / 0%),
      0 0 5px oklch(from var(--energy-color) l c h / 0%),
      0 0 5px oklch(from var(--energy-color) l c h / 0%),
      0 0 5px oklch(from var(--energy-color) l c h / 0%),
      0 0 10px oklch(from var(--energy-color) l c h / 0%);
  }
  25% {
    opacity: 1;
    scale: 1.5;
    text-shadow:
      0 0 5px oklch(from var(--energy-color) l c h / 0%),
      0 0 5px oklch(from var(--energy-color) l c h / 0%),
      0 0 5px oklch(from var(--energy-color) l c h / 0%),
      0 0 5px oklch(from var(--energy-color) l c h / 0%),
      0 0 5px oklch(from var(--energy-color) l c h / 0%),
      0 0 5px oklch(from var(--energy-color) l c h / 0%),
      0 0 5px oklch(from var(--energy-color) l c h / 0%),
      0 0 10px oklch(from var(--energy-color) l c h / 0%);
  }
  26% {
    text-shadow:
      0 0 5px oklch(from var(--energy-color) l c h / 80%),
      0 0 5px oklch(from var(--energy-color) l c h / 0%),
      0 0 5px oklch(from var(--energy-color) l c h / 0%),
      0 0 5px oklch(from var(--energy-color) l c h / 0%),
      0 0 5px oklch(from var(--energy-color) l c h / 0%),
      0 0 5px oklch(from var(--energy-color) l c h / 0%),
      0 0 5px oklch(from var(--energy-color) l c h / 0%),
      0 0 12px oklch(from var(--energy-color) l c h / 12%);
  }
  29% {
    text-shadow:
      -0.857em -0.6em 16.571px oklch(from var(--energy-color) l c h / 45.714%),
      0 0 5px oklch(from var(--energy-color) l c h / 80%),
      0 0 5px oklch(from var(--energy-color) l c h / 0%),
      0 0 5px oklch(from var(--energy-color) l c h / 0%),
      0 0 5px oklch(from var(--energy-color) l c h / 0%),
      0 0 5px oklch(from var(--energy-color) l c h / 0%),
      0 0 5px oklch(from var(--energy-color) l c h / 0%),
      0 0 16px oklch(from var(--energy-color) l c h / 30%);
  }
  32% {
    text-shadow:
      -1.714em -1.2em 28.143px oklch(from var(--energy-color) l c h / 11.429%),
      1.114em 0.043em 16.571px oklch(from var(--energy-color) l c h / 45.714%),
      0 0 5px oklch(from var(--energy-color) l c h / 80%),
      0 0 5px oklch(from var(--energy-color) l c h / 0%),
      0 0 5px oklch(from var(--energy-color) l c h / 0%),
      0 0 5px oklch(from var(--energy-color) l c h / 0%),
      0 0 5px oklch(from var(--energy-color) l c h / 0%),
      0 0 20px oklch(from var(--energy-color) l c h / 50%);
  }
  33% {
    text-shadow:
      -2em -1.4em 32px oklch(from var(--energy-color) l c h / 0%),
      1.486em 0.057em 20.429px oklch(from var(--energy-color) l c h / 34.286%),
      0.257em 0.257em 8.857px oklch(from var(--energy-color) l c h / 68.571%),
      0 0 5px oklch(from var(--energy-color) l c h / 0%),
      0 0 5px oklch(from var(--energy-color) l c h / 0%),
      0 0 5px oklch(from var(--energy-color) l c h / 0%),
      0 0 5px oklch(from var(--energy-color) l c h / 0%),
      0 0 22px oklch(from var(--energy-color) l c h / 58%);
  }
  35% {
    text-shadow:
      -2em -1.4em 32px oklch(from var(--energy-color) l c h / 0%),
      2.229em 0.086em 28.143px oklch(from var(--energy-color) l c h / 11.429%),
      0.771em 0.771em 16.571px oklch(from var(--energy-color) l c h / 45.714%),
      0 0 5px oklch(from var(--energy-color) l c h / 80%),
      0 0 5px oklch(from var(--energy-color) l c h / 0%),
      0 0 5px oklch(from var(--energy-color) l c h / 0%),
      0 0 5px oklch(from var(--energy-color) l c h / 0%),
      0 0 26px oklch(from var(--energy-color) l c h / 70%);
  }
  36% {
    text-shadow:
      -2em -1.4em 32px oklch(from var(--energy-color) l c h / 0%),
