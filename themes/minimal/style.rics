      2.6em 0.1em 32px oklch(from var(--energy-color) l c h / 0%),
      1.8em 1.8em 32px oklch(from var(--energy-color) l c h / 0%),
      1.2em -2.3em 32px oklch(from var(--energy-color) l c h / 0%),
      -2.314em 0.257em 28.143px oklch(from var(--energy-color) l c h / 11.429%),
      -0.643em 0.943em 16.571px oklch(from var(--energy-color) l c h / 45.714%),
      0 0 5px oklch(from var(--energy-color) l c h / 80%),
      0 0 20px oklch(from var(--energy-color) l c h / 42%);
  }
  45% {
    text-shadow:
      -2em -1.4em 32px oklch(from var(--energy-color) l c h / 0%),
      2.6em 0.1em 32px oklch(from var(--energy-color) l c h / 0%),
      1.8em 1.8em 32px oklch(from var(--energy-color) l c h / 0%),
      1.2em -2.3em 32px oklch(from var(--energy-color) l c h / 0%),
      -2.7em 0.3em 32px oklch(from var(--energy-color) l c h / 0%),
      -0.857em 1.257em 20.429px oklch(from var(--energy-color) l c h / 34.286%),
      0.286em -0.243em 8.857px oklch(from var(--energy-color) l c h / 68.571%),
      0 0 18px oklch(from var(--energy-color) l c h / 35%);
  }
  48% {
    text-shadow:
      -2em -1.4em 32px oklch(from var(--energy-color) l c h / 0%),
