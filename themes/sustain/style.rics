@import url("https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&display=swap");

/*
blyrics-hide-instrumental-only = true;
blyrics-target-scroll-pos-ratio = 0.5;
blyrics-letter-wave = true;
*/

:root {
  --yt-album-size: 600px;
  --blyrics-font-size: 3rem;
  --blyrics-hover-scale: 1.01;
  --blyrics-background-color: rgba(0, 0, 0, 0.25);
  --ytmusic-player-bar-background: rgba(87, 87, 87, 0.05);
  --blyrics-font-family:
    "DM Sans", "SF Pro", var(--noto-sans-universal), system-ui, "Segoe UI",
    Roboto, Helvetica, Arial, sans-serif, "Apple Color Emoji", "Segoe UI Emoji",
    "Segoe UI Symbol";
  --blyrics-font-weight: 600;
  --blyrics-wobble-duration: 1s;
  --blyrics-glow-color: color(display-p3 1 1 1 / 0.0001);
  --blyrics-word-wobble-transform-from: scaleX(1);
  --blyrics-word-wobble-transform-peak: translateX(0.0125em) scaleX(1.01);
  --blyrics-word-wobble-transform-settle: translateX(0) scaleX(1);
  --blyrics-word-wobble-transform-to: scaleX(1);
  --blyrics-panel-size: 50%;
  --blyrics-video-panel-size: 50%;
  --blyrics-fullscreen-panel-size: 55%;
  --blyrics-fullscreen-video-panel-size: 55%;
  --yt-img-border-radius: 2rem;
  --ytmusic-nav-bar: transparent;
  --blyrics-img-max-width: 576px;
  --blyrics-lyric-scroll-duration: 581.71ms;
  --blyrics-lyric-scroll-timing-function: linear(0 0%, 0.005927 1%, 0.022466 2%, 0.047872 3%, 0.080554 4%, 0.119068 5%, 0.162116 6%, 0.208536 7%, 0.2573 8%, 0.3075 9%, 0.358346 10%, 0.409157 11%, 0.45935 12%, 0.508438 13%, 0.556014 14%, 0.601751 15%, 0.645389 16%, 0.686733 17%, 0.72564 18%, 0.762019 19%, 0.795818 20%, 0.827026 21%, 0.855662 22%, 0.881772 23%, 0.905423 24%, 0.926704 25%, 0.945714 26%, 0.962568 27%, 0.977386 28%, 0.990295 29%, 1.001426 30%, 1.010911 31%, 1.018881 32%, 1.025465 33%, 1.030792 34%, 1.034982 35%, 1.038155 36%, 1.040423 37%, 1.041892 38%, 1.042662 39%, 1.042827 40%, 1.042473 41%, 1.04168 42%, 1.040522 43%, 1.039065 44%, 1.037371 45%, 1.035493 46%, 1.03348 47%, 1.031376 48%, 1.029217 49%, 1.027037 50%, 1.024864 51%, 1.022722 52%, 1.020631 53%, 1.018608 54%, 1.016667 55%, 1.014817 56%, 1.013067 57%, 1.011422 58%, 1.009887 59%, 1.008462 60%, 1.007148 61%, 1.005944 62%, 1.004847 63%, 1.003855 64%, 1.002964 65%, 1.002169 66%, 1.001466 67%, 1.000848 68%, 1.000311 69%, 0.999849 70%, 0.999457 71%, 0.999128 72%, 0.998858 73%, 0.99864 74%, 0.99847 75%, 0.998342 76%, 0.998253 77%, 0.998196 78%, 0.998169 79%, 0.998167 80%, 0.998186 81%, 0.998224 82%, 0.998276 83%, 0.998341 84%, 0.998415 85%, 0.998497 86%, 0.998584 87%, 0.998675 88%, 0.998768 89%, 0.998861 90%, 0.998954 91%, 0.999045 92%, 0.999134 93%, 0.99922 94%, 0.999303 95%, 0.999381 96%, 0.999455 97%, 0.999525 98%, 0.999589 99%, 0.99965 100%);
  --blyrics-letter-wave-transform: translateY(-0.04em);
  --blyrics-letter-wave-settle: translateY(-0.015em);
  --blyrics-letter-wave-duration: 0.75s;
  --blyrics-letter-wave-emphasis-scale: 1.09;
}


$fullscreen-lyrics-placement: left; // Can be `left` or `right`
$song-info-layout: 1; // Can be `1` or `2`


* {
  font-family: var(--blyrics-font-family);
}

/* .blyrics--active follows the scroll clock and drops ~0.5s before a line stops
   playing; .blyrics--animating follows the audio clock. Older engines only ship
   the former, so match either. */
$playing: ":is(.blyrics--active, .blyrics--animating)";
$selector: "+ .blyrics--line:not(#{$playing})";

@for $i from 1 through 20 {
  $blur: $i + ($i * $i * 0.125);
  $opacity: 1 - ($i * 0.1) - ($i * $i * 0.02);

  .blyrics--line#{$playing} #{$selector} {
    @if $opacity > 0 {
      opacity: $opacity;

      @if $opacity > 0.15 {
        filter: blur(#{$blur}px);
      }
    } @else {
      opacity: 0;
      visibility: hidden;
    }
  }

  $selector: "#{$selector} + .blyrics--line";
}

.blyrics--line.blyrics--active {
  transition:
    filter 0.1s 0s,
    opacity 0.4s 0.166s,
    transform 0.166s var(--blyrics-anim-delay, 0s) !important;
}

.blyrics-user-scrolling .blyrics--line {
  filter: none !important;
  transition: none !important;
  opacity: 1 !important;
  visibility: visible !important;
}

ytmusic-player:not([video-mode]) {
  border-radius: 2rem;
  outline: 1px solid rgb(175 175 175 / 15%);
  overflow: hidden;
}

ytmusic-player[is-music-web-player-page-layout-fixes-enabled]:not([is-mweb-modernization-enabled]):not([video-mode])[player-page-open] {
  border-radius: 2rem;
}

img.yt-img-shadow:not(#song-image img){
  border: 1px solid rgb(175 175 175 / 15%);
  box-sizing: border-box;
}

yt-img-shadow[object-fit=CONTAIN] img.yt-img-shadow[width="56"]{
  --yt-img-border-radius: 1rem;
  border: 1px solid rgb(175 175 175 / 10%);
}

yt-img-shadow[object-fit=CONTAIN] img.yt-img-shadow[width="32"]{
  --yt-img-border-radius: 0.5rem;
}

ytmusic-chip-cloud-chip-renderer.ytmusic-chip-cloud-renderer {
  margin-inline: 1.5px;
}

ytmusic-chip-cloud-chip-renderer[chip-style=STYLE_LARGE_TRANSLUCENT_AND_SELECTED_WHITE] a.ytmusic-chip-cloud-chip-renderer{
  border-radius: 0.375rem;
}

ytmusic-chip-cloud-chip-renderer:first-of-type a.ytmusic-chip-cloud-chip-renderer{
  border-radius: 1rem 0.375rem 0.375rem 1rem;
}

ytmusic-chip-cloud-chip-renderer:last-of-type a.ytmusic-chip-cloud-chip-renderer{
  border-radius: 0.375rem 1rem 1rem 0.375rem;
}

ytmusic-app-layout[is-bauhaus-sidenav-enabled] #nav-bar-divider.ytmusic-app-layout{
  border-top: 1px solid rgba(255, 255, 255, 0);
}

ytmusic-app-layout[is-bauhaus-sidenav-enabled] #nav-bar-background.ytmusic-app-layout{
  border-color: transparent;
}

ytmusic-app-layout[is-bauhaus-sidenav-enabled] #mini-guide-background.ytmusic-app-layout{
  border-right: 1px solid rgba(255, 255, 255, 0);
}

#nav-bar-background.ytmusic-app-layout{
  background: rgba(87, 87, 87, 0.05);
  backdrop-filter: blur(var(--blyrics-blur-amount));
}

#mini-guide-renderer[is-collapsed] #sections .title-column {
  display: none;
}

#mini-guide-renderer[is-collapsed] #sections .guide-icon {
  margin: 0;
}

ytmusic-guide-entry-renderer[is-collapsed] tp-yt-paper-item.ytmusic-guide-entry-renderer{
  aspect-ratio: 1 / 1;
  box-sizing: border-box;
  display: grid;
  border-radius: 1.5rem;
  place-items: center;
  transition: background-color 0.2s ease;
}

ytmusic-guide-entry-renderer:not(:first-of-type){
  margin-top: 1rem;
}

ytmusic-guide-entry-renderer[active] tp-yt-paper-item.ytmusic-guide-entry-renderer {
  --ytmusic-guide-entry-background-color: rgba(87, 87, 87, .25);
}

tp-yt-paper-item.ytmusic-guide-entry-renderer:hover {
  --ytmusic-guide-entry-background-color: rgba(87, 87, 87, .25);
}

#blyrics-song-info {
  letter-spacing: -0.05rem;
}

@media (min-width: 1400px) {
  :root {
    --blyrics-font-size: 4.5rem;
  }
}

@media (min-width: 1600px) {
  :root {
    --blyrics-font-size: 5rem;
  }
}

@media (min-width: 1800px) {
  :root {
    --blyrics-font-size: 6rem;
  }
}

.blyrics-background-lyric {
  font-size: 0.9em;
}

.blyrics-container {
  overflow-y: auto;
  scroll-behavior: smooth;
  padding-top: 10px;
  padding-inline: 20px;
}

.blyrics-container:has(.blyrics--active):not(.blyrics-user-scrolling)
  > div:not(.blyrics--active):not(.blyrics--active ~ div) {
  transition:
    filter calc(var(--blyrics-duration) / 3) 0.4s,
    opacity 0.4s 0s,
    transform calc(var(--blyrics-duration) / 4) 0.4s ease !important;
  opacity: 0;
}

.blyrics-container > div.blyrics--active {
  opacity: 1;
  filter: blur(0px);
}

.blyrics-container > div.blyrics--active ~ div {
  opacity: 0.66;
  filter: blur(0px);
}

.blyrics-container > :is(.blyrics--active, .blyrics--animating) {
  opacity: 1 !important;
  filter: blur(0px);
}

.blyrics-container > div {
  transition:
    filter calc(var(--blyrics-duration) / 3) 0.4s,
    opacity calc(var(--blyrics-duration) / 2) 0.166s,
    transform 0.166s var(--blyrics-anim-delay, 0s) !important;
  padding: 5px 0;
  transform-origin: left center;
}

.blyrics-container > div:hover {
  opacity: 1 !important;
  filter: blur(0px) !important;
  transform: scale(var(--blyrics-hover-scale));
  transition: all 0.3s ease;
}

.blyrics-word-highlight {
  --blyrics-glow-color: color(display-p3 1 1 1 / 0.0001);
}

.blyrics-word-highlight[data-long-word] {
  --blyrics-glow-color: color(display-p3 1 1 1 / 1);
}

@keyframes scalePulse {
  0% {
    transform: scale(1.2);
  }
  50% {
    transform: scale(1.3);
  }
  100% {
    transform: scale(1.2);
  }
}

@keyframes slowRotate {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}

/* Word wobble for the pre-2.4.0.1 engine, which applies this keyframe; the new engine reads the wobble transform variables instead. */
@keyframes blyrics-wobble {
  0% {
    transform: translateY(0);
  }
  100% {
    transform: translateY(-0.0375em);
  }
}

@keyframes marquee-scroll {
  0% {
    transform: translateX(0);
  }
  100% {
    transform: translateX(calc(-50% - 12px));
  }
}

ytmusic-player-page::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -100;
  background: var(--blyrics-background-img);
  background-position: 50% !important;
  background-repeat: no-repeat;
  background-size: cover;
  filter: blur(var(--blyrics-background-blur))
    saturate(var(--blyrics-background-saturate));
  opacity: 0.5;
  transform: scale(1.2);
  transform-origin: center center;
  animation:
    scalePulse 8s ease-in-out infinite,
    slowRotate 30s linear infinite;
  animation-composition: add;
  will-change: transform;
}

ytmusic-player-bar {
  display: grid;
  grid-template-columns: 1.5fr 2fr 1fr;
  grid-template-areas: "start middle end";
}

.left-controls.ytmusic-player-bar {
  grid-area: middle;
  justify-self: center;
  margin-left: calc(56px - 140px);
}

.middle-controls.ytmusic-player-bar {
  grid-area: start;
  justify-content: start;
  margin-left: 16px;
}

.middle-controls.ytmusic-player-bar yt-formatted-string.byline::after {
  content: attr(title);
  padding-left: 24px;
}

.middle-controls.ytmusic-player-bar span.yt-formatted-string {
  overflow: visible !important;
}

.middle-controls.ytmusic-player-bar:hover yt-formatted-string.byline {
  overflow: visible;
  will-change: transform;
  animation: marquee-scroll 8s linear infinite;
}

.middle-controls.ytmusic-player-bar .byline-wrapper {
  mask-image: linear-gradient(
    90deg,
    transparent,
    #000 7.5%,
    #000 92.5%,
    transparent 100%
  );
  mask-size: 115%;
  mask-position: right;
  transition: mask-size 0.15s linear;
}

.middle-controls.ytmusic-player-bar:hover .byline-wrapper {
  mask-size: 100%;
}

.volume-slider.ytmusic-player-bar {
  opacity: 1;
}

.av-toggle.ytmusic-av-toggle {
  background: rgba(255, 255, 255, 0.1);
}

.ytmusic-av-toggle[aria-pressed="false"] {
  background: transparent;
}

.ytmusic-av-toggle[aria-pressed="true"] {
  background: rgba(255, 255, 255, 0.1);
}

@media (min-width: 936px) {
  .side-panel.ytmusic-player-page {
    margin: 0 0 0 calc(var(--ytmusic-player-page-content-gap) - 10px);
  }
}

ytmusic-player-page:not([is-mweb-modernization-enabled]):not([blyrics-video-mode]):not([video-mode]) #player.ytmusic-player-page {
  max-width: var(--blyrics-img-max-width);
}

ytmusic-player-page:not([is-mweb-modernization-enabled])[player-fullscreened]:not([blyrics-video-mode]):not([video-mode]) ytmusic-player:not([video-mode]) {
  @if $song-info-layout == 1{
    border-radius: 2rem 2rem 0 0;
    --yt-img-border-radius: 2rem 2rem 0 0;
  }
}

ytmusic-player-page:not([is-mweb-modernization-enabled])[player-fullscreened]:not([blyrics-dfs]) #blyrics-song-info {
  text-align: left;
  width: 100%;
  max-width: var(--blyrics-img-max-width);
  margin-bottom: 4rem;
  z-index: -1;
  transform: translateY(-64px);
  box-sizing: border-box;
  transition: max-width 0.5s ease-in-out;
  transition-delay: var(--blyrics-no-lyrics-slide-delay);
  @if $song-info-layout == 1 {
    padding: 2rem;
    margin-bottom: 8rem;
    outline: 1px dashed rgb(255 255 255 / 15%);
    border-radius: 0 0 2rem 2rem;
    z-index: -1;
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(4px);
    box-shadow: rgba(0, 0, 0, 0.1) 0px 20px 20px 0px;
  }
}

ytmusic-player-page:not([is-mweb-modernization-enabled])[player-fullscreened][video-mode]:not([blyrics-dfs]) #blyrics-song-info {
  max-width: unset;
}

ytmusic-player-page:not([is-mweb-modernization-enabled])[player-fullscreened]:not([blyrics-dfs]) #player.ytmusic-player-page {
  box-shadow: rgba(0, 0, 0, 0.1) 0px 54px 55px, rgba(0, 0, 0, 0.06) 0px -12px 30px, rgba(0, 0, 0, 0.06) 0px 4px 6px, rgba(0, 0, 0, 0.09) 0px 12px 13px, rgba(0, 0, 0, 0.04) 0px -3px 5px;
}

#blyrics-song-info > p#blyrics-title {
  font-size: 2.5rem;
  color: color(display-p3 1 1 1);
}

#blyrics-song-info > p#blyrics-artist {
  color: color(display-p3 1 1 1 / 0.5);
  opacity: 1;
}

ytmusic-player-page[player-fullscreened]:not([blyrics-video-mode]):not([blyrics-dfs]):has(.blyrics-container[data-no-lyrics="true"]) #blyrics-song-info{
  max-width: 500px !important;
}

ytmusic-player-page:not([is-mweb-modernization-enabled])[player-fullscreened]:not([blyrics-dfs]):has(.blyrics-container[data-no-lyrics="true"]) .content.ytmusic-player-page {
  flex-direction: row;
}

ytmusic-player-page:not([is-mweb-modernization-enabled])[player-fullscreened]:not([blyrics-dfs]) .content.ytmusic-player-page {
  @if $fullscreen-lyrics-placement == left {
    flex-direction: row-reverse;
  } @else {
    flex-direction: row;
  }
}